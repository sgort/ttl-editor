  <decision id="BerekenLeeftijden" name="leeftijden">
    <informationRequirement id="InformationRequirement_10qlb4f">
      <requiredDecision href="#leeftijdAOQMaanden" />
    </informationRequirement>
    <decisionTable id="DecisionTable_08t7k43" hitPolicy="FIRST">
      <input id="InputClause_0930juh" label="geboortedatum aanvrager">
        <inputExpression id="LiteralExpression_1tx8sla" typeRef="date">
          <text>geboortedatumAanvrager</text>
        </inputExpression>
      </input>
      <input id="InputClause_04mpdgn" label="geboortedatum partner">
        <inputExpression id="LiteralExpression_16moqnx" typeRef="date">
          <text>geboortedatumPartner</text>
        </inputExpression>
      </input>
      <output id="OutputClause_0xe0jzj" label="leeftijd aanvrager" name="leeftijdAanvrager" typeRef="number" />
      <output id="OutputClause_0ed4f7p" label="AOW ingangdsdatum aanvrager" name="AOWDatumAanvrager" typeRef="date" />
      <output id="OutputClause_0zslmma" label="leeftijd partner" name="leeftijdPartner" typeRef="number" />
      <output id="OutputClause_0khepdx" label="AOW ingangsdatum partner" name="AOWDatumPartner" typeRef="date" />
      <rule id="DecisionRule_0yhbjku">
        <inputEntry id="UnaryTests_00iq2ln">
          <text></text>
        </inputEntry>
        <inputEntry id="UnaryTests_1rz5l4l">
          <text></text>
        </inputEntry>
        <outputEntry id="LiteralExpression_17bh597">
          <text>years and months duration(date(geboortedatumAanvrager), 	
date(dagVanAanvraag)).years</text>
        </outputEntry>
        <outputEntry id="LiteralExpression_0v8l3ie">
          <text>date(geboortedatumAanvrager) + duration("P"+string(leeftijdAOQMaanden)+"M")</text>
        </outputEntry>
        <outputEntry id="LiteralExpression_0lrtvjg">
          <text>years and months duration(date(geboortedatumPartner), 	
date(dagVanAanvraag)).years</text>
        </outputEntry>
        <outputEntry id="LiteralExpression_1b6dy00">
          <text>date(geboortedatumPartner) + duration("P"+string(leeftijdAOQMaanden)+"M")</text>
        </outputEntry>
      </rule>
    </decisionTable>
  </decision>
  <decision id="leeftijdsgrenzen" name="leeftijdsgrenzen">
    <informationRequirement id="InformationRequirement_1awdfzs">
      <requiredDecision href="#BerekenLeeftijden" />
    </informationRequirement>
    <decisionTable id="DecisionTable_0ms5zhm" hitPolicy="FIRST">
      <output id="OutputClause_1h8b3hk" label="de aanvrager is tenminste 18" name="deAanvragerIsTenminste18" typeRef="boolean" biodi:width="360" />
      <output id="OutputClause_0ioq0jp" label="de aanvrager is onder de 18 jaar" name="aanvragerOnderDe18Jaar" typeRef="boolean" />
      <output id="OutputClause_0dy2rx5" label="de aanvrager is 18, 19, of 20 jaar oud" name="aanvrager181920" typeRef="boolean" />
      <output id="OutputClause_04ch67c" label="de aanvrager is tenminste 21" name="aanvragerTenminste21" typeRef="boolean" />
      <output id="OutputClause_10sobxi" label="de aanvrager is jonger dan de AOW leeftijd bij de aanvraag" name="aanvragerJongerAOW" typeRef="boolean" />
      <output id="OutputClause_0ixu2dq" label="de aanvrager heeft de AOW leeftijd bereikt op de dag van aanvraag" name="aanvragerOuderAOW" typeRef="boolean" />
      <output id="OutputClause_0maebil" label="de partner is tenminste 18" name="dePartnerIsTenminste18" typeRef="boolean" />
      <output id="OutputClause_1t8smwo" label="partner 18, 19, 20" name="partner181920" typeRef="boolean" />
      <output id="OutputClause_0ceiufe" label="de partner is tenminste 21" name="partnerTenminste21" typeRef="boolean" />
      <output id="OutputClause_126ah0u" label="de partner is jonger dan de AOW leeftijd bij de aanvraag" name="partnerJongerAOW" typeRef="boolean" />
      <output id="OutputClause_13299rm" label="de partner heeft de AOW leeftijd bereikt op de dag van aanvraag" name="partnerOuderAOW" typeRef="boolean" />
      <rule id="DecisionRule_0tk28ea">
        <outputEntry id="LiteralExpression_1k1hvkf">
          <text>BerekenLeeftijden.leeftijdAanvrager &gt;= 18</text>
        </outputEntry>
        <outputEntry id="LiteralExpression_0owps50">
          <text>BerekenLeeftijden.leeftijdAanvrager &lt; 18</text>
        </outputEntry>
        <outputEntry id="LiteralExpression_0lol8ak">
          <text>18 &lt;= BerekenLeeftijden.leeftijdAanvrager  and BerekenLeeftijden.leeftijdAanvrager &lt;= 20</text>
        </outputEntry>
        <outputEntry id="LiteralExpression_0vxhu52">
          <text>21 &lt;= BerekenLeeftijden.leeftijdAanvrager</text>
        </outputEntry>
        <outputEntry id="LiteralExpression_0cmvvat">
          <text>date(dagVanAanvraag) &lt; date(BerekenLeeftijden.AOWDatumAanvrager)</text>
        </outputEntry>
        <outputEntry id="LiteralExpression_0bst813">
          <text>date(dagVanAanvraag) &gt;= date(BerekenLeeftijden.AOWDatumAanvrager)</text>
        </outputEntry>
        <outputEntry id="LiteralExpression_0jqmz4c">
          <text>BerekenLeeftijden.leeftijdPartner &lt;= 18</text>
        </outputEntry>
        <outputEntry id="LiteralExpression_1r0xrl3">
          <text>18 &lt;= BerekenLeeftijden.leeftijdPartner and BerekenLeeftijden.leeftijdPartner &lt;= 21</text>
        </outputEntry>
        <outputEntry id="LiteralExpression_01azdss">
          <text>BerekenLeeftijden.leeftijdPartner &gt;= 21</text>
        </outputEntry>
        <outputEntry id="LiteralExpression_0ebhl6y">
          <text>date(dagVanAanvraag) &lt; date(BerekenLeeftijden.AOWDatumPartner)</text>
        </outputEntry>
        <outputEntry id="LiteralExpression_1t34dfy">
          <text>date(dagVanAanvraag) &gt;= date(BerekenLeeftijden.AOWDatumPartner)</text>
        </outputEntry>
      </rule>
    </decisionTable>
  </decision>
