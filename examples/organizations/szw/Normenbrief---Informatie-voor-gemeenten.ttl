# =====================================
# NL-SBB Concept Definitions (DMN Variables)
# =====================================

<https://regels.overheid.nl/schemes/dmn-variables> a skos:ConceptScheme ;
    dct:title "DMN Variabelen Begrippenkader"@nl ;
    dct:description "Begrippenkader voor invoer- en uitvoervariabelen van DMN beslisregels in het RONL stelsel."@nl ;
    dct:creator "RONL" ;
    dct:created "2026-09-10"^^xsd:date .

# Input Variable Concepts

<https://regels.overheid.nl/concepts/pw-normbedragen/peildatum> a skos:Concept ;
    skos:prefLabel "Peildatum"@nl ;
    skos:definition "Peildatum is een tekstuele waarde die als invoer dient voor de beslisregel."@nl ;
    skos:notation "PEIL" ;
    dct:subject <https://regels.overheid.nl/services/normbedragen-jul26-041/dmn/input/1> ;
    dct:type "dmn:InputVariable" ;
    skos:exactMatch <https://regels.overheid.nl/concepts/peildatum> ;
    skos:inScheme <https://regels.overheid.nl/schemes/dmn-variables> .

<https://regels.overheid.nl/concepts/pw-normbedragen/norm> a skos:Concept ;
    skos:prefLabel "Norm"@nl ;
    skos:definition "Norm is een tekstuele waarde die als invoer dient voor de beslisregel."@nl ;
    skos:notation "NORM" ;
    dct:subject <https://regels.overheid.nl/services/normbedragen-jul26-041/dmn/input/2> ;
    dct:type "dmn:InputVariable" ;
    skos:exactMatch <https://regels.overheid.nl/concepts/norm> ;
    skos:inScheme <https://regels.overheid.nl/schemes/dmn-variables> .

# Output Variable Concepts

<https://regels.overheid.nl/concepts/pw-normbedragen/bedrag> a skos:Concept ;
    skos:prefLabel "Bedrag"@nl ;
    skos:definition "Bedrag is een waarde die als uitvoer wordt gegenereerd door de beslisregel."@nl ;
    skos:notation "BEDR" ;
    dct:subject <https://regels.overheid.nl/services/normbedragen-jul26-041/dmn/output/1> ;
    dct:type "dmn:OutputVariable" ;
    skos:exactMatch <https://regels.overheid.nl/concepts/bedrag> ;
    skos:inScheme <https://regels.overheid.nl/schemes/dmn-variables> .

