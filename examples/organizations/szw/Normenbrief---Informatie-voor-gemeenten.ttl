<https://regels.overheid.nl/services/normbedragen-jul26-041> a cpsv:PublicService ;
    dct:identifier "normbedragen-jul26-041" ;
    dct:title "Normenbrief - Informatie voor gemeenten"@nl ;
    dct:description "Ieder half jaar veranderen de bedragen en percentages voor de uitvoering van de Participatiewet, IOAW, IOAZ en het Bbz 2004. Het gaat onder meer om de bijstandsnormen, de minimumbedragen studietoeslag en de grondslagen IOAW en IOAZ. De uitkeringen worden ieder halfjaar aangepast als gevolg van de indexering van het wettelijk minimumuurloon."@nl ;
    cv:sector <https://publications.europa.eu/resource/authority/corporate-body-classification/NATIONAL> ;
    dcat:keyword "allowance, social, income,"@nl ;
    dct:language <https://publications.europa.eu/resource/authority/language/NL> ;
    cv:hasCompetentAuthority <https://organisaties.overheid.nl/19087/Sociale_Zaken_en_Werkgelegenheid> ;
    cv:hasLegalResource <https://wetten.overheid.nl/BWBR0015703> ;
    cprmv:hasDecisionModel <https://regels.overheid.nl/services/normbedragen-jul26-041/dmn>  .

