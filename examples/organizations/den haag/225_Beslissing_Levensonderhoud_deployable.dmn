<?xml version='1.0' encoding='UTF-8'?>
<definitions xmlns="https://www.omg.org/spec/DMN/20191111/MODEL/" xmlns:dmndi="https://www.omg.org/spec/DMN/20191111/DMNDI/" xmlns:dc="http://www.omg.org/spec/DMN/20180521/DC/" xmlns:modeler="http://camunda.org/schema/modeler/1.0" xmlns:di="http://www.omg.org/spec/DMN/20180521/DI/" xmlns:biodi="http://bpmn.io/schema/dmn/biodi/2.0" xmlns:camunda="http://camunda.org/schema/1.0/dmn" id="dt225_drd" name="Beslissing Levensonderhoud" namespace="http://camunda.org/schema/1.0/dmn" exporter="RONL CPSV Editor" exporterVersion="1.9.0" modeler:executionPlatform="Camunda Platform" modeler:executionPlatformVersion="7.23.0">
  <!-- ============================================================
       INPUT DATA — flat, executable variables.
       Naming follows the Heusdenpas convention (camelCase Dutch).
       ============================================================ -->
  <!-- Request and household context -->
  <inputData id="InputData_aanvraagtypeALO" name="aanvraagtypeALO">
    <variable id="Variable_aanvraagtypeALO" name="aanvraagtypeALO" typeRef="boolean"/>
  </inputData>
  <inputData id="InputData_lopendeAanvraagOfUitkering" name="lopendeAanvraagOfUitkering">
    <variable id="Variable_lopendeAanvraagOfUitkering" name="lopendeAanvraagOfUitkering" typeRef="boolean"/>
  </inputData>
  <inputData id="InputData_eersteAanvragerVastgesteld" name="eersteAanvragerVastgesteld">
    <variable id="Variable_eersteAanvragerVastgesteld" name="eersteAanvragerVastgesteld" typeRef="boolean"/>
  </inputData>
  <inputData id="InputData_tweedeAanvragerVastgesteld" name="tweedeAanvragerVastgesteld">
    <variable id="Variable_tweedeAanvragerVastgesteld" name="tweedeAanvragerVastgesteld" typeRef="boolean"/>
  </inputData>
  <!-- Substantive eligibility inputs (RechtOpALO) -->
  <inputData id="InputData_ongeoorloofdOnbetaaldVerlof" name="ongeoorloofdOnbetaaldVerlof">
    <variable id="Variable_ongeoorloofdOnbetaaldVerlof" name="ongeoorloofdOnbetaaldVerlof" typeRef="string"/>
  </inputData>
  <inputData id="InputData_maandelijksInkomen" name="maandelijksInkomen">
    <variable id="Variable_maandelijksInkomen" name="maandelijksInkomen" typeRef="double"/>
  </inputData>
  <inputData id="InputData_bijstandsNorm" name="bijstandsNorm">
    <variable id="Variable_bijstandsNorm" name="bijstandsNorm" typeRef="double"/>
  </inputData>
  <inputData id="InputData_geenInAanmerkingTeNemenVermogen" name="geenInAanmerkingTeNemenVermogen">
    <variable id="Variable_geenInAanmerkingTeNemenVermogen" name="geenInAanmerkingTeNemenVermogen" typeRef="boolean"/>
  </inputData>
  <inputData id="InputData_voorliggendeVoorzieningenUitsluiting" name="voorliggendeVoorzieningenUitsluiting">
    <variable id="Variable_voorliggendeVoorzieningenUitsluiting" name="voorliggendeVoorzieningenUitsluiting" typeRef="boolean"/>
  </inputData>
  <!-- BeslissingALO context -->
  <inputData id="InputData_bijstandsVorm" name="bijstandsVorm">
    <variable id="Variable_bijstandsVorm" name="bijstandsVorm" typeRef="string"/>
  </inputData>
  <!-- Per-person inputs: applicant -->
  <inputData id="InputData_aanvragerWoonachtigInGemeente" name="aanvragerWoonachtigInGemeente">
    <variable id="Variable_aanvragerWoonachtigInGemeente" name="aanvragerWoonachtigInGemeente" typeRef="boolean"/>
  </inputData>
  <inputData id="InputData_aanvragerLeeftijdOK" name="aanvragerLeeftijdOK">
    <variable id="Variable_aanvragerLeeftijdOK" name="aanvragerLeeftijdOK" typeRef="boolean"/>
  </inputData>
  <inputData id="InputData_aanvragerVerblijfstitelOK" name="aanvragerVerblijfstitelOK">
    <variable id="Variable_aanvragerVerblijfstitelOK" name="aanvragerVerblijfstitelOK" typeRef="boolean"/>
  </inputData>
  <inputData id="InputData_aanvragerDetentie" name="aanvragerDetentie">
    <variable id="Variable_aanvragerDetentie" name="aanvragerDetentie" typeRef="boolean"/>
  </inputData>
  <inputData id="InputData_aanvragerMaatregel100" name="aanvragerMaatregel100">
    <variable id="Variable_aanvragerMaatregel100" name="aanvragerMaatregel100" typeRef="boolean"/>
  </inputData>
  <inputData id="InputData_aanvragerRechtOpStufi" name="aanvragerRechtOpStufi">
    <variable id="Variable_aanvragerRechtOpStufi" name="aanvragerRechtOpStufi" typeRef="boolean"/>
  </inputData>
  <inputData id="InputData_aanvragerInformatieOnvolledig" name="aanvragerInformatieOnvolledig">
    <variable id="Variable_aanvragerInformatieOnvolledig" name="aanvragerInformatieOnvolledig" typeRef="boolean"/>
  </inputData>
  <!-- Per-person inputs: partner -->
  <inputData id="InputData_partnerWoonachtigInGemeente" name="partnerWoonachtigInGemeente">
    <variable id="Variable_partnerWoonachtigInGemeente" name="partnerWoonachtigInGemeente" typeRef="boolean"/>
  </inputData>
  <inputData id="InputData_partnerLeeftijdOK" name="partnerLeeftijdOK">
    <variable id="Variable_partnerLeeftijdOK" name="partnerLeeftijdOK" typeRef="boolean"/>
  </inputData>
  <inputData id="InputData_partnerVerblijfstitelOK" name="partnerVerblijfstitelOK">
    <variable id="Variable_partnerVerblijfstitelOK" name="partnerVerblijfstitelOK" typeRef="boolean"/>
  </inputData>
  <inputData id="InputData_partnerDetentie" name="partnerDetentie">
    <variable id="Variable_partnerDetentie" name="partnerDetentie" typeRef="boolean"/>
  </inputData>
  <inputData id="InputData_partnerMaatregel100" name="partnerMaatregel100">
    <variable id="Variable_partnerMaatregel100" name="partnerMaatregel100" typeRef="boolean"/>
  </inputData>
  <inputData id="InputData_partnerRechtOpStufi" name="partnerRechtOpStufi">
    <variable id="Variable_partnerRechtOpStufi" name="partnerRechtOpStufi" typeRef="boolean"/>
  </inputData>
  <inputData id="InputData_partnerInformatieOnvolledig" name="partnerInformatieOnvolledig">
    <variable id="Variable_partnerInformatieOnvolledig" name="partnerInformatieOnvolledig" typeRef="boolean"/>
  </inputData>
  <!-- Professional-judgement inputs (standalone decisions) -->
  <inputData id="InputData_oordeelTekortSchieten" name="oordeelTekortSchieten">
    <variable id="Variable_oordeelTekortSchieten" name="oordeelTekortSchieten" typeRef="string"/>
  </inputData>
  <inputData id="InputData_oordeelDringendeReden" name="oordeelDringendeReden">
    <variable id="Variable_oordeelDringendeReden" name="oordeelDringendeReden" typeRef="string"/>
  </inputData>
  <inputData id="InputData_oordeelHardheidsclausule" name="oordeelHardheidsclausule">
    <variable id="Variable_oordeelHardheidsclausule" name="oordeelHardheidsclausule" typeRef="string"/>
  </inputData>
  <!-- ============================================================
       dt225_RechthebbendeAanvrager
       Per-person eligibility verdict for the applicant.
       ============================================================ -->
  <decision id="dt225_BeslissingALO" name="Beslissing ALO" camunda:historyTimeToLive="0">
    <informationRequirement id="InformationRequirement_bes_recht">
      <requiredDecision href="#dt225_RechtOpALO"/>
    </informationRequirement>
    <informationRequirement id="InformationRequirement_bes_vorm">
      <requiredInput href="#InputData_bijstandsVorm"/>
    </informationRequirement>
    <decisionTable id="DecisionTable_BeslissingALO" hitPolicy="FIRST">
      <input id="Input_bes_recht" label="Recht op ALO">
        <inputExpression id="InputExpr_bes_recht" typeRef="string">
          <text>rechtOpALO</text>
        </inputExpression>
        <inputValues id="InputValues_bes_recht">
          <text>"rood","oranje","groen"</text>
        </inputValues>
      </input>
      <input id="Input_bes_vorm" label="Bijstandsvorm">
        <inputExpression id="InputExpr_bes_vorm" typeRef="string">
          <text>bijstandsVorm</text>
        </inputExpression>
        <inputValues id="InputValues_bes_vorm">
          <text>"Om niet","Krediethypotheek","Verhaalbare bijstand","Leenbijstand"</text>
        </inputValues>
      </input>
      <output id="Output_bes_result" label="Beslissing ALO" name="beslissingALO" typeRef="string"/>
      <output id="Output_bes_reden" label="Reden afwijzing (passthrough)" name="redenAfwijzing" typeRef="string"/>
      <output id="Output_bes_info" label="Informatiebehoefte (passthrough)" name="informatiebehoefte" typeRef="string"/>
      <rule id="Rule_Bes_GeenRecht">
        <description>Geen recht — afwijzing ongeacht bijstandsvorm</description>
        <inputEntry id="InE_bes_recht_01">
          <text>"rood"</text>
        </inputEntry>
        <inputEntry id="InE_bes_vorm_01">
          <text/>
        </inputEntry>
        <outputEntry id="OutE_bes_result_01">
          <text>"Geen recht"</text>
        </outputEntry>
        <outputEntry id="OutE_bes_reden_01">
          <text>redenAfwijzing</text>
        </outputEntry>
        <outputEntry id="OutE_bes_info_01">
          <text>informatiebehoefte</text>
        </outputEntry>
      </rule>
      <rule id="Rule_Bes_Informatie">
        <description>Informatie nog onvolledig — beslissing aangehouden</description>
        <inputEntry id="InE_bes_recht_02">
          <text>"oranje"</text>
        </inputEntry>
        <inputEntry id="InE_bes_vorm_02">
          <text/>
        </inputEntry>
        <outputEntry id="OutE_bes_result_02">
          <text>"Informatie nodig"</text>
        </outputEntry>
        <outputEntry id="OutE_bes_reden_02">
          <text>redenAfwijzing</text>
        </outputEntry>
        <outputEntry id="OutE_bes_info_02">
          <text>informatiebehoefte</text>
        </outputEntry>
      </rule>
      <rule id="Rule_Bes_OmNiet">
        <inputEntry id="InE_bes_recht_03">
          <text>"groen"</text>
        </inputEntry>
        <inputEntry id="InE_bes_vorm_03">
          <text>"Om niet"</text>
        </inputEntry>
        <outputEntry id="OutE_bes_result_03">
          <text>"Om niet"</text>
        </outputEntry>
        <outputEntry id="OutE_bes_reden_03">
          <text>redenAfwijzing</text>
        </outputEntry>
        <outputEntry id="OutE_bes_info_03">
          <text>informatiebehoefte</text>
        </outputEntry>
      </rule>
      <rule id="Rule_Bes_Krediethypotheek">
        <inputEntry id="InE_bes_recht_04">
          <text>"groen"</text>
        </inputEntry>
        <inputEntry id="InE_bes_vorm_04">
          <text>"Krediethypotheek"</text>
        </inputEntry>
        <outputEntry id="OutE_bes_result_04">
          <text>"Krediethypotheek"</text>
        </outputEntry>
        <outputEntry id="OutE_bes_reden_04">
          <text>redenAfwijzing</text>
        </outputEntry>
        <outputEntry id="OutE_bes_info_04">
          <text>informatiebehoefte</text>
        </outputEntry>
      </rule>
      <rule id="Rule_Bes_Verhaalbaar">
        <inputEntry id="InE_bes_recht_05">
          <text>"groen"</text>
        </inputEntry>
        <inputEntry id="InE_bes_vorm_05">
          <text>"Verhaalbare bijstand"</text>
        </inputEntry>
        <outputEntry id="OutE_bes_result_05">
          <text>"Verhaalbare bijstand"</text>
        </outputEntry>
        <outputEntry id="OutE_bes_reden_05">
          <text>redenAfwijzing</text>
        </outputEntry>
        <outputEntry id="OutE_bes_info_05">
          <text>informatiebehoefte</text>
        </outputEntry>
      </rule>
      <rule id="Rule_Bes_Leenbijstand">
        <inputEntry id="InE_bes_recht_06">
          <text>"groen"</text>
        </inputEntry>
        <inputEntry id="InE_bes_vorm_06">
          <text>"Leenbijstand"</text>
        </inputEntry>
        <outputEntry id="OutE_bes_result_06">
          <text>"Leenbijstand"</text>
        </outputEntry>
        <outputEntry id="OutE_bes_reden_06">
          <text>redenAfwijzing</text>
        </outputEntry>
        <outputEntry id="OutE_bes_info_06">
          <text>informatiebehoefte</text>
        </outputEntry>
      </rule>
      <rule id="Rule_Bes_Fallback">
        <description>Recht vastgesteld maar bijstandsvorm niet bepaald</description>
        <inputEntry id="InE_bes_recht_07">
          <text>"groen"</text>
        </inputEntry>
        <inputEntry id="InE_bes_vorm_07">
          <text/>
        </inputEntry>
        <outputEntry id="OutE_bes_result_07">
          <text>"Bijstandsvorm te bepalen"</text>
        </outputEntry>
        <outputEntry id="OutE_bes_reden_07">
          <text>redenAfwijzing</text>
        </outputEntry>
        <outputEntry id="OutE_bes_info_07">
          <text>informatiebehoefte</text>
        </outputEntry>
      </rule>
    </decisionTable>
  </decision>
  <decision id="dt225_RechthebbendeAanvrager" name="Rechthebbende aanvrager" camunda:historyTimeToLive="0">
    <informationRequirement id="InformationRequirement_aanv_01">
      <requiredInput href="#InputData_aanvragerWoonachtigInGemeente"/>
    </informationRequirement>
    <informationRequirement id="InformationRequirement_aanv_02">
      <requiredInput href="#InputData_aanvragerLeeftijdOK"/>
    </informationRequirement>
    <informationRequirement id="InformationRequirement_aanv_03">
      <requiredInput href="#InputData_aanvragerVerblijfstitelOK"/>
    </informationRequirement>
    <informationRequirement id="InformationRequirement_aanv_04">
      <requiredInput href="#InputData_aanvragerDetentie"/>
    </informationRequirement>
    <informationRequirement id="InformationRequirement_aanv_05">
      <requiredInput href="#InputData_aanvragerMaatregel100"/>
    </informationRequirement>
    <informationRequirement id="InformationRequirement_aanv_06">
      <requiredInput href="#InputData_aanvragerRechtOpStufi"/>
    </informationRequirement>
    <informationRequirement id="InformationRequirement_aanv_07">
      <requiredInput href="#InputData_aanvragerInformatieOnvolledig"/>
    </informationRequirement>
    <decisionTable id="DecisionTable_RechthebbendeAanvrager" hitPolicy="FIRST">
      <input id="Input_aanv_inf" label="Informatie onvolledig">
        <inputExpression id="InputExpr_aanv_inf" typeRef="boolean">
          <text>aanvragerInformatieOnvolledig</text>
        </inputExpression>
      </input>
      <input id="Input_aanv_woon" label="Woonachtig in gemeente">
        <inputExpression id="InputExpr_aanv_woon" typeRef="boolean">
          <text>aanvragerWoonachtigInGemeente</text>
        </inputExpression>
      </input>
      <input id="Input_aanv_lftd" label="Leeftijd OK">
        <inputExpression id="InputExpr_aanv_lftd" typeRef="boolean">
          <text>aanvragerLeeftijdOK</text>
        </inputExpression>
      </input>
      <input id="Input_aanv_verb" label="Verblijfstitel OK">
        <inputExpression id="InputExpr_aanv_verb" typeRef="boolean">
          <text>aanvragerVerblijfstitelOK</text>
        </inputExpression>
      </input>
      <input id="Input_aanv_det" label="Detentie">
        <inputExpression id="InputExpr_aanv_det" typeRef="boolean">
          <text>aanvragerDetentie</text>
        </inputExpression>
      </input>
      <input id="Input_aanv_maat" label="Opgelegde 100% maatregel">
        <inputExpression id="InputExpr_aanv_maat" typeRef="boolean">
          <text>aanvragerMaatregel100</text>
        </inputExpression>
      </input>
      <input id="Input_aanv_stufi" label="Recht op studiefinanciering">
        <inputExpression id="InputExpr_aanv_stufi" typeRef="boolean">
          <text>aanvragerRechtOpStufi</text>
        </inputExpression>
      </input>
      <output id="Output_aanv_status" label="Rechthebbende aanvrager" name="rechthebbendeAanvrager" typeRef="string">
        <outputValues id="OutputValues_aanv_status">
          <text>"rood","oranje","groen"</text>
        </outputValues>
      </output>
      <output id="Output_aanv_info" label="Informatiebehoefte aanvrager" name="informatiebehoefteAanvrager" typeRef="string"/>
      <rule id="Rule_Aanv_InfoOnvolledig">
        <description>Informatie onvolledig — kan nog niet beslissen</description>
        <inputEntry id="InE_aanv_inf_01">
          <text>true</text>
        </inputEntry>
        <inputEntry id="InE_aanv_woon_01">
          <text/>
        </inputEntry>
        <inputEntry id="InE_aanv_lftd_01">
          <text/>
        </inputEntry>
        <inputEntry id="InE_aanv_verb_01">
          <text/>
        </inputEntry>
        <inputEntry id="InE_aanv_det_01">
          <text/>
        </inputEntry>
        <inputEntry id="InE_aanv_maat_01">
          <text/>
        </inputEntry>
        <inputEntry id="InE_aanv_stufi_01">
          <text/>
        </inputEntry>
        <outputEntry id="OutE_aanv_status_01">
          <text>"oranje"</text>
        </outputEntry>
        <outputEntry id="OutE_aanv_info_01">
          <text>"informatie onvolledig"</text>
        </outputEntry>
      </rule>
      <rule id="Rule_Aanv_NietWoonachtig">
        <description>Niet woonachtig in gemeente — geen recht</description>
        <inputEntry id="InE_aanv_inf_02">
          <text/>
        </inputEntry>
        <inputEntry id="InE_aanv_woon_02">
          <text>false</text>
        </inputEntry>
        <inputEntry id="InE_aanv_lftd_02">
          <text/>
        </inputEntry>
        <inputEntry id="InE_aanv_verb_02">
          <text/>
        </inputEntry>
        <inputEntry id="InE_aanv_det_02">
          <text/>
        </inputEntry>
        <inputEntry id="InE_aanv_maat_02">
          <text/>
        </inputEntry>
        <inputEntry id="InE_aanv_stufi_02">
          <text/>
        </inputEntry>
        <outputEntry id="OutE_aanv_status_02">
          <text>"rood"</text>
        </outputEntry>
        <outputEntry id="OutE_aanv_info_02">
          <text>"woonplaats"</text>
        </outputEntry>
      </rule>
      <rule id="Rule_Aanv_LeeftijdNietOK">
        <description>Leeftijd niet OK — geen recht</description>
        <inputEntry id="InE_aanv_inf_03">
          <text/>
        </inputEntry>
        <inputEntry id="InE_aanv_woon_03">
          <text/>
        </inputEntry>
        <inputEntry id="InE_aanv_lftd_03">
          <text>false</text>
        </inputEntry>
        <inputEntry id="InE_aanv_verb_03">
          <text/>
        </inputEntry>
        <inputEntry id="InE_aanv_det_03">
          <text/>
        </inputEntry>
        <inputEntry id="InE_aanv_maat_03">
          <text/>
        </inputEntry>
        <inputEntry id="InE_aanv_stufi_03">
          <text/>
        </inputEntry>
        <outputEntry id="OutE_aanv_status_03">
          <text>"rood"</text>
        </outputEntry>
        <outputEntry id="OutE_aanv_info_03">
          <text>"leeftijd"</text>
        </outputEntry>
      </rule>
      <rule id="Rule_Aanv_VerblijfstitelNietOK">
        <description>Verblijfstitel niet OK — geen recht</description>
        <inputEntry id="InE_aanv_inf_04">
          <text/>
        </inputEntry>
        <inputEntry id="InE_aanv_woon_04">
          <text/>
        </inputEntry>
        <inputEntry id="InE_aanv_lftd_04">
          <text/>
        </inputEntry>
        <inputEntry id="InE_aanv_verb_04">
          <text>false</text>
        </inputEntry>
        <inputEntry id="InE_aanv_det_04">
          <text/>
        </inputEntry>
        <inputEntry id="InE_aanv_maat_04">
          <text/>
        </inputEntry>
        <inputEntry id="InE_aanv_stufi_04">
          <text/>
        </inputEntry>
        <outputEntry id="OutE_aanv_status_04">
          <text>"rood"</text>
        </outputEntry>
        <outputEntry id="OutE_aanv_info_04">
          <text>"verblijfstitel"</text>
        </outputEntry>
      </rule>
      <rule id="Rule_Aanv_Detentie">
        <description>Detentie — geen recht</description>
        <inputEntry id="InE_aanv_inf_05">
          <text/>
        </inputEntry>
        <inputEntry id="InE_aanv_woon_05">
          <text/>
        </inputEntry>
        <inputEntry id="InE_aanv_lftd_05">
          <text/>
        </inputEntry>
        <inputEntry id="InE_aanv_verb_05">
          <text/>
        </inputEntry>
        <inputEntry id="InE_aanv_det_05">
          <text>true</text>
        </inputEntry>
        <inputEntry id="InE_aanv_maat_05">
          <text/>
        </inputEntry>
        <inputEntry id="InE_aanv_stufi_05">
          <text/>
        </inputEntry>
        <outputEntry id="OutE_aanv_status_05">
          <text>"rood"</text>
        </outputEntry>
        <outputEntry id="OutE_aanv_info_05">
          <text>"detentie"</text>
        </outputEntry>
      </rule>
      <rule id="Rule_Aanv_Maatregel">
        <description>Opgelegde 100% maatregel — geen recht</description>
        <inputEntry id="InE_aanv_inf_06">
          <text/>
        </inputEntry>
        <inputEntry id="InE_aanv_woon_06">
          <text/>
        </inputEntry>
        <inputEntry id="InE_aanv_lftd_06">
          <text/>
        </inputEntry>
        <inputEntry id="InE_aanv_verb_06">
          <text/>
        </inputEntry>
        <inputEntry id="InE_aanv_det_06">
          <text/>
        </inputEntry>
        <inputEntry id="InE_aanv_maat_06">
          <text>true</text>
        </inputEntry>
        <inputEntry id="InE_aanv_stufi_06">
          <text/>
        </inputEntry>
        <outputEntry id="OutE_aanv_status_06">
          <text>"rood"</text>
        </outputEntry>
        <outputEntry id="OutE_aanv_info_06">
          <text>"opgelegde maatregel"</text>
        </outputEntry>
      </rule>
      <rule id="Rule_Aanv_Stufi">
        <description>Recht op studiefinanciering — geen recht op ALO</description>
        <inputEntry id="InE_aanv_inf_07">
          <text/>
        </inputEntry>
        <inputEntry id="InE_aanv_woon_07">
          <text/>
        </inputEntry>
        <inputEntry id="InE_aanv_lftd_07">
          <text/>
        </inputEntry>
        <inputEntry id="InE_aanv_verb_07">
          <text/>
        </inputEntry>
        <inputEntry id="InE_aanv_det_07">
          <text/>
        </inputEntry>
        <inputEntry id="InE_aanv_maat_07">
          <text/>
        </inputEntry>
        <inputEntry id="InE_aanv_stufi_07">
          <text>true</text>
        </inputEntry>
        <outputEntry id="OutE_aanv_status_07">
          <text>"rood"</text>
        </outputEntry>
        <outputEntry id="OutE_aanv_info_07">
          <text>"stufi"</text>
        </outputEntry>
      </rule>
      <rule id="Rule_Aanv_Groen">
        <description>Alle criteria positief — rechthebbend</description>
        <inputEntry id="InE_aanv_inf_08">
          <text>false</text>
        </inputEntry>
        <inputEntry id="InE_aanv_woon_08">
          <text>true</text>
        </inputEntry>
