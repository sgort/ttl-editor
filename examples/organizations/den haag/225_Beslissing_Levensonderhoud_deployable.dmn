  <!-- ============================================================
       dt225_BeslissingALO
       Final decision: maps Recht op ALO + BijstandsVorm
       into the concrete grant-type outcome.
       ============================================================ -->
  <!-- ============================================================
       Standalone professional-judgement decisions.
       Each consumes a single text-typed professional opinion and
       yields a boolean. Not wired into RechtOpALO in the original
       theoretical model, so they remain standalone.
       ============================================================ -->
  <decision id="dt225_TekortSchieten" name="Tekort schieten besef verantwoordelijkheden?" camunda:historyTimeToLive="0">
    <variable id="Variable_tekort" name="tekortSchieten" typeRef="boolean"/>
    <informationRequirement id="InformationRequirement_tekort_in">
      <requiredInput href="#InputData_oordeelTekortSchieten"/>
    </informationRequirement>
    <decisionTable id="DecisionTable_TekortSchieten" hitPolicy="FIRST">
      <input id="Input_tekort" label="Oordeel professional">
        <inputExpression id="InputExpr_tekort" typeRef="string">
          <text>oordeelTekortSchieten</text>
        </inputExpression>
      </input>
      <output id="Output_tekort" typeRef="boolean"/>
      <rule id="Rule_Tekort_Schiet">
        <inputEntry id="InE_tekort_01">
          <text>"Belanghebbende schiet tekort"</text>
        </inputEntry>
        <outputEntry id="OutE_tekort_01">
          <text>true</text>
        </outputEntry>
      </rule>
      <rule id="Rule_Tekort_Default">
        <inputEntry id="InE_tekort_02">
          <text/>
        </inputEntry>
        <outputEntry id="OutE_tekort_02">
          <text>false</text>
        </outputEntry>
      </rule>
    </decisionTable>
  </decision>
  <decision id="dt225_DringendeReden" name="Dringende reden?" camunda:historyTimeToLive="0">
    <variable id="Variable_dringend" name="dringendeReden" typeRef="boolean"/>
    <informationRequirement id="InformationRequirement_dringend_in">
      <requiredInput href="#InputData_oordeelDringendeReden"/>
    </informationRequirement>
    <decisionTable id="DecisionTable_DringendeReden" hitPolicy="FIRST">
      <input id="Input_dringend" label="Oordeel professional">
        <inputExpression id="InputExpr_dringend" typeRef="string">
          <text>oordeelDringendeReden</text>
        </inputExpression>
      </input>
      <output id="Output_dringend" typeRef="boolean"/>
      <rule id="Rule_Dringend_Ja">
        <inputEntry id="InE_dringend_01">
          <text>"ja"</text>
        </inputEntry>
        <outputEntry id="OutE_dringend_01">
          <text>true</text>
        </outputEntry>
      </rule>
      <rule id="Rule_Dringend_Default">
        <inputEntry id="InE_dringend_02">
          <text/>
        </inputEntry>
        <outputEntry id="OutE_dringend_02">
          <text>false</text>
        </outputEntry>
      </rule>
    </decisionTable>
  </decision>
  <decision id="dt225_HardheidsclausuleToepassen" name="Hardheidsclausule toepassen?" camunda:historyTimeToLive="0">
    <variable id="Variable_hardheid" name="hardheidsclausuleToepassen" typeRef="boolean"/>
    <informationRequirement id="InformationRequirement_hardheid_in">
      <requiredInput href="#InputData_oordeelHardheidsclausule"/>
    </informationRequirement>
    <decisionTable id="DecisionTable_HardheidsclausuleToepassen" hitPolicy="FIRST">
      <input id="Input_hardheid" label="Oordeel professional">
        <inputExpression id="InputExpr_hardheid" typeRef="string">
          <text>oordeelHardheidsclausule</text>
        </inputExpression>
      </input>
      <output id="Output_hardheid" typeRef="boolean"/>
      <rule id="Rule_Hardheid_Ja">
        <inputEntry id="InE_hardheid_01">
          <text>"ja"</text>
        </inputEntry>
        <outputEntry id="OutE_hardheid_01">
          <text>true</text>
        </outputEntry>
      </rule>
      <rule id="Rule_Hardheid_Default">
        <inputEntry id="InE_hardheid_02">
          <text/>
        </inputEntry>
        <outputEntry id="OutE_hardheid_02">
          <text>false</text>
        </outputEntry>
      </rule>
    </decisionTable>
  </decision>
