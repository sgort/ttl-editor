  <!-- ============================================================
       dt225_RechtOpALO
       Top-level right-determination, combines all eligibility
       criteria into a single rood/oranje/groen verdict.
       ============================================================ -->
  <decision id="dt225_RechtOpALO" name="Recht op ALO" camunda:historyTimeToLive="0">
    <informationRequirement id="InformationRequirement_rop_aanvraag">
      <requiredInput href="#InputData_aanvraagtypeALO"/>
    </informationRequirement>
    <informationRequirement id="InformationRequirement_rop_lopend">
      <requiredInput href="#InputData_lopendeAanvraagOfUitkering"/>
    </informationRequirement>
    <informationRequirement id="InformationRequirement_rop_eerste">
      <requiredInput href="#InputData_eersteAanvragerVastgesteld"/>
    </informationRequirement>
    <informationRequirement id="InformationRequirement_rop_tweede">
      <requiredInput href="#InputData_tweedeAanvragerVastgesteld"/>
    </informationRequirement>
    <informationRequirement id="InformationRequirement_rop_verlof">
      <requiredInput href="#InputData_ongeoorloofdOnbetaaldVerlof"/>
    </informationRequirement>
    <informationRequirement id="InformationRequirement_rop_ink">
      <requiredInput href="#InputData_maandelijksInkomen"/>
    </informationRequirement>
    <informationRequirement id="InformationRequirement_rop_norm">
      <requiredInput href="#InputData_bijstandsNorm"/>
    </informationRequirement>
    <informationRequirement id="InformationRequirement_rop_verm">
      <requiredInput href="#InputData_geenInAanmerkingTeNemenVermogen"/>
    </informationRequirement>
    <informationRequirement id="InformationRequirement_rop_voor">
      <requiredInput href="#InputData_voorliggendeVoorzieningenUitsluiting"/>
    </informationRequirement>
    <informationRequirement id="InformationRequirement_rop_aanv">
      <requiredDecision href="#dt225_RechthebbendeAanvrager"/>
    </informationRequirement>
    <informationRequirement id="InformationRequirement_rop_part">
      <requiredDecision href="#dt225_RechthebbendePartner"/>
    </informationRequirement>
    <decisionTable id="DecisionTable_RechtOpALO" hitPolicy="FIRST">
      <input id="Input_rop_aanvraag" label="Aanvraag is ALO">
        <inputExpression id="InputExpr_rop_aanvraag" typeRef="boolean">
          <text>aanvraagtypeALO</text>
        </inputExpression>
      </input>
      <input id="Input_rop_lopend" label="Lopende aanvraag of uitkering?">
        <inputExpression id="InputExpr_rop_lopend" typeRef="boolean">
          <text>lopendeAanvraagOfUitkering</text>
        </inputExpression>
      </input>
      <input id="Input_rop_eerste" label="Eerste aanvrager vastgesteld">
        <inputExpression id="InputExpr_rop_eerste" typeRef="boolean">
          <text>eersteAanvragerVastgesteld</text>
        </inputExpression>
      </input>
      <input id="Input_rop_tweede" label="Tweede aanvrager vastgesteld">
        <inputExpression id="InputExpr_rop_tweede" typeRef="boolean">
          <text>tweedeAanvragerVastgesteld</text>
        </inputExpression>
      </input>
      <input id="Input_rop_aanv" label="Rechthebbende aanvrager">
        <inputExpression id="InputExpr_rop_aanv" typeRef="string">
          <text>rechthebbendeAanvrager</text>
        </inputExpression>
        <inputValues id="InputValues_rop_aanv">
          <text>"rood","oranje","groen"</text>
        </inputValues>
      </input>
      <input id="Input_rop_part" label="Rechthebbende partner">
        <inputExpression id="InputExpr_rop_part" typeRef="string">
          <text>rechthebbendePartner</text>
        </inputExpression>
        <inputValues id="InputValues_rop_part">
          <text>"rood","oranje","groen"</text>
        </inputValues>
      </input>
      <input id="Input_rop_verlof" label="Ongeoorloofd onbetaald verlof">
        <inputExpression id="InputExpr_rop_verlof" typeRef="string">
          <text>ongeoorloofdOnbetaaldVerlof</text>
        </inputExpression>
        <inputValues id="InputValues_rop_verlof">
          <text>"ja","nee","onbekend"</text>
        </inputValues>
      </input>
      <input id="Input_rop_lagink" label="Laag inkomen (inkomen &lt; bijstandsnorm)">
        <inputExpression id="InputExpr_rop_lagink" typeRef="boolean">
          <text>maandelijksInkomen &lt; bijstandsNorm</text>
        </inputExpression>
      </input>
      <input id="Input_rop_verm" label="Geen in aanmerking te nemen vermogen">
        <inputExpression id="InputExpr_rop_verm" typeRef="boolean">
          <text>geenInAanmerkingTeNemenVermogen</text>
        </inputExpression>
      </input>
      <input id="Input_rop_voor" label="Voorliggende voorzieningen die uitsluiten">
        <inputExpression id="InputExpr_rop_voor" typeRef="boolean">
          <text>voorliggendeVoorzieningenUitsluiting</text>
        </inputExpression>
      </input>
      <output id="Output_rop_status" label="Recht op ALO" name="rechtOpALO" typeRef="string">
        <outputValues id="OutputValues_rop_status">
          <text>"rood","oranje","groen"</text>
        </outputValues>
      </output>
      <output id="Output_rop_reden" label="Reden afwijzing" name="redenAfwijzing" typeRef="string"/>
