              "});",
              "",
              "pm.test(\"Response is a JSON array\", function () {",
              "    const jsonData = pm.response.json();",
              "    pm.expect(jsonData).to.be.an('array');",
              "});",
              "",
              "pm.test(\"Response array has at least one item\", function () {",
              "    const jsonData = pm.response.json();",
              "    pm.expect(jsonData.length).to.be.greaterThan(0);",
              "});",
              "",
              "pm.test(\"plafondEigenaren is present and has correct structure\", function () {",
              "    const jsonData = pm.response.json();",
              "    const item = jsonData[0];",
              "    pm.expect(item).to.have.property('plafondEigenaren');",
              "    pm.expect(item.plafondEigenaren).to.have.property('type', 'Double');",
              "    pm.expect(item.plafondEigenaren).to.have.property('value');",
              "    pm.expect(item.plafondEigenaren.value).to.be.a('number').and.greaterThan(0);",
              "});",
              "",
              "pm.test(\"plafondHuurders is present and has correct structure\", function () {",
              "    const jsonData = pm.response.json();",
              "    const item = jsonData[0];",
              "    pm.expect(item).to.have.property('plafondHuurders');",
              "    pm.expect(item.plafondHuurders).to.have.property('type', 'Double');",
              "    pm.expect(item.plafondHuurders).to.have.property('value');",
              "    pm.expect(item.plafondHuurders.value).to.be.a('number').and.greaterThan(0);",
              "});",
              "",
              "pm.test(\"plafondEigenaren and plafondHuurders both have value 437500.0\", function () {",
              "    const jsonData = pm.response.json();",
              "    const item = jsonData[0];",
              "    pm.expect(item.plafondEigenaren.value).to.eql(437500.0);",
              "    pm.expect(item.plafondHuurders.value).to.eql(437500.0);",
              "});",
              "",
              "pm.test(\"aanvraagDatum 2026-03-18: plafondEigenaren and plafondHuurders both have value 437500.0\", function () {",
