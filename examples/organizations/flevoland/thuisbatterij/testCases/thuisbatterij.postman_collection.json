    {
      "name": "BehaalbareHoogteSubsidie- netto hoogte test 1250",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "let output;\r",
              "\r",
              "try {\r",
              "  output = pm.response.json();\r",
              "} catch (e) {\r",
              "  output = null;\r",
              "}\r",
              "\r",
              "const expectedHoogteSubsidie = 1250;\r",
              "const actualHoogteSubsidie = output?.[0]?.hoogteSubsidie?.value;\r",
              "\r",
              "const passed = actualHoogteSubsidie === expectedHoogteSubsidie;\r",
              "\r",
              "console.log(\"Status code:\", pm.response.code);\r",
              "console.log(\"Expected hoogteSubsidie:\", expectedHoogteSubsidie);\r",
              "console.log(\"Actual hoogteSubsidie:\", actualHoogteSubsidie);\r",
              "console.log(\"Passed:\", passed);\r",
              "\r",
              "pm.test(\"Request was successful\", function () {\r",
              "  pm.expect(pm.response.code).to.eql(200);\r",
              "});\r",
              "\r",
              "pm.test(\"hoogteSubsidie is 1250\", function () {\r",
              "  pm.expect(actualHoogteSubsidie).to.eql(expectedHoogteSubsidie);\r",
              "});\r",
              "\r",
              "const template = `\r",
              "  <h2>Decision Test Result</h2>\r",
              "\r",
              "  <p><strong>Status code:</strong> {{statusCode}}</p>\r",
              "\r",
              "  <p>\r",
              "    <strong>Test result:</strong>\r",
              "    {{#if passed}}\r",
              "      <span style=\"color: green; font-weight: bold;\">PASS</span>\r",
              "    {{else}}\r",
              "      <span style=\"color: red; font-weight: bold;\">FAIL</span>\r",
              "    {{/if}}\r",
              "  </p>\r",
              "\r",
              "  <h3>hoogteSubsidie</h3>\r",
              "  <p><strong>Expected:</strong> {{expected}}</p>\r",
              "  <p><strong>Actual:</strong> {{actual}}</p>\r",
              "\r",
              "  <h3>Full response</h3>\r",
              "  <pre>{{response}}</pre>\r",
              "`;\r",
              "\r",
              "pm.visualizer.set(template, {\r",
              "  statusCode: pm.response.code,\r",
              "  passed: passed,\r",
              "  expected: expectedHoogteSubsidie,\r",
              "  actual: actualHoogteSubsidie,\r",
              "  response: JSON.stringify(output, null, 2)\r",
              "});"
            ],
            "type": "text/javascript",
            "packages": {},
            "requests": {}
          }
