      <bpmn:outgoing>Flow_035_Task_ControlerenProcedure_to_Gateway_AdviesProcedure</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="Gateway_AdviesProcedure" name="Advies procedure nodig?" default="Flow_037_Gateway_AdviesProcedure_to_Task_VerzendBerichtProcedure">
      <bpmn:incoming>Flow_035_Task_ControlerenProcedure_to_Gateway_AdviesProcedure</bpmn:incoming>
