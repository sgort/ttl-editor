      <bpmn:outgoing>Flow_041_Task_BeoordeelComplexeAanvraag_to_Gateway_ComplexeAanvraag</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="Gateway_ComplexeAanvraag" name="Complexe aanvraag?" default="Flow_043_Gateway_ComplexeAanvraag_to_Gateway_MergeSamenwerking">
      <bpmn:incoming>Flow_041_Task_BeoordeelComplexeAanvraag_to_Gateway_ComplexeAanvraag</bpmn:incoming>
      <bpmn:outgoing>Flow_042_Gateway_ComplexeAanvraag_to_Task_ControlerenCoordinatieregeling</bpmn:outgoing>
