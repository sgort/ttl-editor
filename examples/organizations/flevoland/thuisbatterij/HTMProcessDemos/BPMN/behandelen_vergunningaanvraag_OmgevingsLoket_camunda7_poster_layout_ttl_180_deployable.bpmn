    <bpmn:userTask id="Task_OpstellenAdviesDeelgebied" name="Opstellen advies deelgebied(en)">
      <bpmn:incoming>Flow_049_Task_UitvoerenInhoudelijkeToetsing_to_Task_OpstellenAdviesDeelgebied</bpmn:incoming>
