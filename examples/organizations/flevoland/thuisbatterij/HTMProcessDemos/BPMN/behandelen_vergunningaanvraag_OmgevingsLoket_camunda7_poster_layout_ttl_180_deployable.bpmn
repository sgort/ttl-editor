      <bpmn:outgoing>Flow_037_Gateway_AdviesProcedure_to_Task_VerzendBerichtProcedure</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="Task_AdviserenProcedure" name="Adviseren procedure">
