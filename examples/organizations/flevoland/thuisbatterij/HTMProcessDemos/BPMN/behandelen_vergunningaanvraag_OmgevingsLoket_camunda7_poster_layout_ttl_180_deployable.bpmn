    </bpmn:userTask>
    <bpmn:exclusiveGateway id="Gateway_MergeSamenwerking" name="Externe samenwerking bepaald">
      <bpmn:incoming>Flow_043_Gateway_ComplexeAanvraag_to_Gateway_MergeSamenwerking</bpmn:incoming>
