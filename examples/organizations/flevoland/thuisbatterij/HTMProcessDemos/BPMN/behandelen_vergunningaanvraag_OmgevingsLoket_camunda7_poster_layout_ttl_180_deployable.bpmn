    <bpmn:userTask id="Task_BetrekkenInterneAdviseurs" name="Betrekken interne adviseurs">
      <bpmn:incoming>Flow_046_Gateway_MergeSamenwerking_to_Task_BetrekkenInterneAdviseurs</bpmn:incoming>
