<?xml version='1.0' encoding='UTF-8'?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:camunda="http://camunda.org/schema/1.0/bpmn" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="Definitions_BehandelenVergunningaanvraag" targetNamespace="https://www.gemmaonline.nl/bpmn/behandelen-vergunningaanvraag" exporter="ChatGPT" exporterVersion="GPT-5.5 Thinking">
  <bpmn:category id="Category_Phases">
    <bpmn:categoryValue id="CategoryValue_Phase1" value="Intake vergunningaanvraag"/>
    <bpmn:categoryValue id="CategoryValue_Phase2" value="Inhoudelijk behandelen vergunningaanvraag"/>
    <bpmn:categoryValue id="CategoryValue_Phase3" value="Besluiten vergunningaanvraag"/>
    <bpmn:categoryValue id="CategoryValue_Phase4" value="Bekendmaken besluit vergunningaanvraag"/>
  </bpmn:category>
  <bpmn:message id="Message_AmbtshalveVerzoek" name="Ambtshalve verzoek revisie/aanscherping/intrekking"/>
  <bpmn:message id="Message_AanvraagDoorgezonden" name="Vergunningaanvraag doorgezonden"/>
  <bpmn:process id="Process_BehandelenVergunningaanvraag" name="Behandelen aanvraag omgevingsvergunning" isExecutable="true" camunda:historyTimeToLive="180">
    <bpmn:documentation>Camunda 7-compatible BPMN model derived from the GEMMA Online process poster 'Bedrijfsproces Behandelen aanvraag omgevingsvergunning'. The model is intentionally conservative: manual decision points from the poster are represented as user tasks and exclusive gateways with process variables. Configure forms, assignees, listeners and service implementations in Camunda/Operaton as needed. Source PDF: https://www.gemmaonline.nl/images/gemma/5/58/Procesposter_bedrijfsproces_015_Behandelen_vergunningaanvraag.pdf Routing variables used: viaOmgevingsloket, gemeenteBevoegdGezag, adviesVergunningplichtNodig, vergunningplichtig, adviesAanvraagvereistenNodig, aanvraagVoldoet, aanvullingVoldoende, adviesProcedureNodig, complexeAanvraag, extraGegevensNodig, hervattenNaAanvulling, planschadeRisico, aanpassingAanvraagNodig, collegeAccordNodig, raadsadviesGewenst, uitgebreideProcedure, geschilpuntenUitZienswijzen, collegeVaststellingNodig, registratieNodig, omgevingsplanBijwerken, toezichtNodig.</bpmn:documentation>
    <bpmn:startEvent id="Start_AanvraagIngediend" name="Vergunningaanvraag ingediend">
      <bpmn:outgoing>Flow_001_Start_AanvraagIngediend_to_Task_RegistrerenVTH</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:startEvent id="Start_AmbtshalveVerzoek" name="Ambtshalve verzoek revisie/aanscherping/intrekking">
      <bpmn:outgoing>Flow_002_Start_AmbtshalveVerzoek_to_Task_RegistrerenVTH</bpmn:outgoing>
      <bpmn:messageEventDefinition id="MsgDef_AmbtshalveVerzoek" messageRef="Message_AmbtshalveVerzoek"/>
    </bpmn:startEvent>
    <bpmn:startEvent id="Start_Doorgezonden" name="Vergunningaanvraag doorgezonden">
      <bpmn:outgoing>Flow_003_Start_Doorgezonden_to_Task_RegistrerenVTH</bpmn:outgoing>
      <bpmn:messageEventDefinition id="MsgDef_Doorgezonden" messageRef="Message_AanvraagDoorgezonden"/>
    </bpmn:startEvent>
    <bpmn:userTask id="Task_RegistrerenVTH" name="Registreren aanvraag in VTH-systeem">
      <bpmn:incoming>Flow_001_Start_AanvraagIngediend_to_Task_RegistrerenVTH</bpmn:incoming>
      <bpmn:incoming>Flow_002_Start_AmbtshalveVerzoek_to_Task_RegistrerenVTH</bpmn:incoming>
      <bpmn:incoming>Flow_003_Start_Doorgezonden_to_Task_RegistrerenVTH</bpmn:incoming>
      <bpmn:outgoing>Flow_004_Task_RegistrerenVTH_to_Gateway_ViaOmgevingsloket</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="Gateway_ViaOmgevingsloket" name="Via Omgevingsloket?" default="Flow_006_Gateway_ViaOmgevingsloket_to_Task_OntvangstbevestigingArchief">
      <bpmn:incoming>Flow_004_Task_RegistrerenVTH_to_Gateway_ViaOmgevingsloket</bpmn:incoming>
      <bpmn:outgoing>Flow_005_Gateway_ViaOmgevingsloket_to_Task_RegistrerenOmgevingsloket</bpmn:outgoing>
      <bpmn:outgoing>Flow_006_Gateway_ViaOmgevingsloket_to_Task_OntvangstbevestigingArchief</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="Task_RegistrerenOmgevingsloket" name="Registreren aanvraag in Omgevingsloket">
      <bpmn:incoming>Flow_005_Gateway_ViaOmgevingsloket_to_Task_RegistrerenOmgevingsloket</bpmn:incoming>
      <bpmn:outgoing>Flow_007_Task_RegistrerenOmgevingsloket_to_Task_OntvangstbevestigingArchief</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="Task_OntvangstbevestigingArchief" name="Verzenden ontvangstbevestiging en archiveren aanvraag/bijlagen">
      <bpmn:incoming>Flow_006_Gateway_ViaOmgevingsloket_to_Task_OntvangstbevestigingArchief</bpmn:incoming>
      <bpmn:incoming>Flow_007_Task_RegistrerenOmgevingsloket_to_Task_OntvangstbevestigingArchief</bpmn:incoming>
      <bpmn:outgoing>Flow_008_Task_OntvangstbevestigingArchief_to_Task_PublicerenAanvraag</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="Task_PublicerenAanvraag" name="Publiceren aanvraag">
      <bpmn:incoming>Flow_008_Task_OntvangstbevestigingArchief_to_Task_PublicerenAanvraag</bpmn:incoming>
      <bpmn:outgoing>Flow_009_Task_PublicerenAanvraag_to_Task_ToewijzenHoofdbehandelaar</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="Task_ToewijzenHoofdbehandelaar" name="Toewijzen aan hoofdbehandelaar">
      <bpmn:incoming>Flow_009_Task_PublicerenAanvraag_to_Task_ToewijzenHoofdbehandelaar</bpmn:incoming>
      <bpmn:outgoing>Flow_010_Task_ToewijzenHoofdbehandelaar_to_Task_ControlerenBevoegdGezag</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="Task_ControlerenBevoegdGezag" name="Controleren bevoegd gezag">
      <bpmn:incoming>Flow_010_Task_ToewijzenHoofdbehandelaar_to_Task_ControlerenBevoegdGezag</bpmn:incoming>
      <bpmn:outgoing>Flow_011_Task_ControlerenBevoegdGezag_to_Gateway_BevoegdGezag</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="Gateway_BevoegdGezag" name="Gemeente bevoegd gezag?" default="Flow_013_Gateway_BevoegdGezag_to_Task_OverdragenBevoegdGezag">
      <bpmn:incoming>Flow_011_Task_ControlerenBevoegdGezag_to_Gateway_BevoegdGezag</bpmn:incoming>
      <bpmn:outgoing>Flow_012_Gateway_BevoegdGezag_to_Task_ControlerenVergunningplicht</bpmn:outgoing>
      <bpmn:outgoing>Flow_013_Gateway_BevoegdGezag_to_Task_OverdragenBevoegdGezag</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="Task_OverdragenBevoegdGezag" name="Overdragen aan bevoegd bestuursorgaan">
      <bpmn:incoming>Flow_013_Gateway_BevoegdGezag_to_Task_OverdragenBevoegdGezag</bpmn:incoming>
      <bpmn:outgoing>Flow_014_Task_OverdragenBevoegdGezag_to_End_GestaaktOverdracht</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:endEvent id="End_GestaaktOverdracht" name="Behandelen vergunningaanvraag gestaakt - overgedragen">
      <bpmn:incoming>Flow_014_Task_OverdragenBevoegdGezag_to_End_GestaaktOverdracht</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:userTask id="Task_ControlerenVergunningplicht" name="Controleren vergunningplicht">
      <bpmn:incoming>Flow_012_Gateway_BevoegdGezag_to_Task_ControlerenVergunningplicht</bpmn:incoming>
      <bpmn:outgoing>Flow_015_Task_ControlerenVergunningplicht_to_Gateway_AdviesVergunningplicht</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="Gateway_AdviesVergunningplicht" name="Advies vergunningplicht nodig?" default="Flow_017_Gateway_AdviesVergunningplicht_to_Gateway_Vergunningplichtig">
      <bpmn:incoming>Flow_015_Task_ControlerenVergunningplicht_to_Gateway_AdviesVergunningplicht</bpmn:incoming>
      <bpmn:outgoing>Flow_016_Gateway_AdviesVergunningplicht_to_Task_AdviserenVergunningplicht</bpmn:outgoing>
      <bpmn:outgoing>Flow_017_Gateway_AdviesVergunningplicht_to_Gateway_Vergunningplichtig</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="Task_AdviserenVergunningplicht" name="Adviseren vergunningplicht">
      <bpmn:incoming>Flow_016_Gateway_AdviesVergunningplicht_to_Task_AdviserenVergunningplicht</bpmn:incoming>
      <bpmn:outgoing>Flow_018_Task_AdviserenVergunningplicht_to_Gateway_Vergunningplichtig</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="Gateway_Vergunningplichtig" name="Vergunningplichtig?" default="Flow_020_Gateway_Vergunningplichtig_to_Task_BerichtGeenVergunningplicht">
      <bpmn:incoming>Flow_017_Gateway_AdviesVergunningplicht_to_Gateway_Vergunningplichtig</bpmn:incoming>
      <bpmn:incoming>Flow_018_Task_AdviserenVergunningplicht_to_Gateway_Vergunningplichtig</bpmn:incoming>
      <bpmn:outgoing>Flow_019_Gateway_Vergunningplichtig_to_Task_ControlerenAanvraagvereisten</bpmn:outgoing>
      <bpmn:outgoing>Flow_020_Gateway_Vergunningplichtig_to_Task_BerichtGeenVergunningplicht</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="Task_BerichtGeenVergunningplicht" name="Bericht: geen vergunningplicht / meldingplicht">
      <bpmn:incoming>Flow_020_Gateway_Vergunningplichtig_to_Task_BerichtGeenVergunningplicht</bpmn:incoming>
      <bpmn:outgoing>Flow_021_Task_BerichtGeenVergunningplicht_to_Task_PublicerenBuitenbehandelingGeenPlicht</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="Task_PublicerenBuitenbehandelingGeenPlicht" name="Publiceren buitenbehandelingstelling">
      <bpmn:incoming>Flow_021_Task_BerichtGeenVergunningplicht_to_Task_PublicerenBuitenbehandelingGeenPlicht</bpmn:incoming>
      <bpmn:outgoing>Flow_022_Task_PublicerenBuitenbehandelingGeenPlicht_to_End_GestaaktGeenVergunningplicht</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:endEvent id="End_GestaaktGeenVergunningplicht" name="Gestaakt - geen vergunningplicht">
      <bpmn:incoming>Flow_022_Task_PublicerenBuitenbehandelingGeenPlicht_to_End_GestaaktGeenVergunningplicht</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:userTask id="Task_ControlerenAanvraagvereisten" name="Controleren aanvraagvereisten">
      <bpmn:incoming>Flow_019_Gateway_Vergunningplichtig_to_Task_ControlerenAanvraagvereisten</bpmn:incoming>
      <bpmn:incoming>Flow_031_Gateway_AanvullingVoldoende_to_Task_ControlerenAanvraagvereisten</bpmn:incoming>
      <bpmn:outgoing>Flow_023_Task_ControlerenAanvraagvereisten_to_Gateway_AdviesAanvraagvereisten</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="Gateway_AdviesAanvraagvereisten" name="Advies aanvraagvereisten nodig?" default="Flow_025_Gateway_AdviesAanvraagvereisten_to_Gateway_AanvraagVoldoet">
      <bpmn:incoming>Flow_023_Task_ControlerenAanvraagvereisten_to_Gateway_AdviesAanvraagvereisten</bpmn:incoming>
      <bpmn:outgoing>Flow_024_Gateway_AdviesAanvraagvereisten_to_Task_AdviserenAanvraagvereisten</bpmn:outgoing>
      <bpmn:outgoing>Flow_025_Gateway_AdviesAanvraagvereisten_to_Gateway_AanvraagVoldoet</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="Task_AdviserenAanvraagvereisten" name="Adviseren aanvraagvereisten">
      <bpmn:incoming>Flow_024_Gateway_AdviesAanvraagvereisten_to_Task_AdviserenAanvraagvereisten</bpmn:incoming>
      <bpmn:outgoing>Flow_026_Task_AdviserenAanvraagvereisten_to_Gateway_AanvraagVoldoet</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="Gateway_AanvraagVoldoet" name="Aanvraag voldoet?" default="Flow_028_Gateway_AanvraagVoldoet_to_Task_VerzoekAanvulling">
      <bpmn:incoming>Flow_025_Gateway_AdviesAanvraagvereisten_to_Gateway_AanvraagVoldoet</bpmn:incoming>
      <bpmn:incoming>Flow_026_Task_AdviserenAanvraagvereisten_to_Gateway_AanvraagVoldoet</bpmn:incoming>
      <bpmn:outgoing>Flow_027_Gateway_AanvraagVoldoet_to_Task_ControlerenProcedure</bpmn:outgoing>
      <bpmn:outgoing>Flow_028_Gateway_AanvraagVoldoet_to_Task_VerzoekAanvulling</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="Task_VerzoekAanvulling" name="Verzoek aanvulling aanvraag">
      <bpmn:incoming>Flow_028_Gateway_AanvraagVoldoet_to_Task_VerzoekAanvulling</bpmn:incoming>
      <bpmn:outgoing>Flow_029_Task_VerzoekAanvulling_to_Receive_AanvullingOfTermijn</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="Receive_AanvullingOfTermijn" name="Ontvang aanvulling of termijn verstreken">
      <bpmn:incoming>Flow_029_Task_VerzoekAanvulling_to_Receive_AanvullingOfTermijn</bpmn:incoming>
      <bpmn:outgoing>Flow_030_Receive_AanvullingOfTermijn_to_Gateway_AanvullingVoldoende</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="Gateway_AanvullingVoldoende" name="Aanvulling voldoende?" default="Flow_032_Gateway_AanvullingVoldoende_to_Task_BesluitNietBehandelen">
      <bpmn:incoming>Flow_030_Receive_AanvullingOfTermijn_to_Gateway_AanvullingVoldoende</bpmn:incoming>
      <bpmn:outgoing>Flow_031_Gateway_AanvullingVoldoende_to_Task_ControlerenAanvraagvereisten</bpmn:outgoing>
      <bpmn:outgoing>Flow_032_Gateway_AanvullingVoldoende_to_Task_BesluitNietBehandelen</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="Task_BesluitNietBehandelen" name="Besluit aanvraag niet behandelen">
      <bpmn:incoming>Flow_032_Gateway_AanvullingVoldoende_to_Task_BesluitNietBehandelen</bpmn:incoming>
      <bpmn:outgoing>Flow_033_Task_BesluitNietBehandelen_to_Task_BekendmakenNietBehandelen</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="Task_BekendmakenNietBehandelen" name="Bekendmaken en publiceren buitenbehandelingstelling">
      <bpmn:incoming>Flow_033_Task_BesluitNietBehandelen_to_Task_BekendmakenNietBehandelen</bpmn:incoming>
      <bpmn:outgoing>Flow_034_Task_BekendmakenNietBehandelen_to_End_GestaaktAanvraagvereisten</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:endEvent id="End_GestaaktAanvraagvereisten" name="Gestaakt - aanvraagvereisten onvoldoende">
      <bpmn:incoming>Flow_034_Task_BekendmakenNietBehandelen_to_End_GestaaktAanvraagvereisten</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:userTask id="Task_ControlerenProcedure" name="Controleren procedure">
