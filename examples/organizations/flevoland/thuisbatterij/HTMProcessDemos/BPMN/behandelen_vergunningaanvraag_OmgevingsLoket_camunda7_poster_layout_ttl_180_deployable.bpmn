      <bpmn:outgoing>Flow_039_Task_VerzendBerichtProcedure_to_Event_IntakeGereed</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:intermediateThrowEvent id="Event_IntakeGereed" name="Intake vergunningaanvraag gereed">
