<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:camunda="http://camunda.org/schema/1.0/bpmn" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:modeler="http://camunda.org/schema/modeler/1.0" id="Definitions_048o8dy" targetNamespace="http://bpmn.io/schema/bpmn" exporter="Camunda Modeler" exporterVersion="5.46.1" modeler:executionPlatform="Camunda Platform" modeler:executionPlatformVersion="7.23.0">
  <bpmn:process id="processAanvraagInfoBezwaar" name="simpele aanvraag met extra informatie en bezwaar" isExecutable="true" camunda:historyTimeToLive="0">
    <bpmn:startEvent id="start" name="aanvraag subsidie">
      <bpmn:extensionElements>
        <camunda:executionListener event="start">
          <camunda:script scriptFormat="javascript">// Default process variables for processAanvraagInfoBezwaar.
// setDefault only writes when the variable is not already present, so anything
// supplied in the REST start payload takes precedence; this fills in the rest
// and guarantees all variables exist (and are visible in Cockpit) from the start.
function setDefault(name, value) {
  if (!execution.hasVariable(name)) {
    execution.setVariable(name, value);
  }
}

// booleans
setDefault("needsExtraInformation", false);
setDefault("willComplain", false);
setDefault("eligibleInitial", true);
setDefault("eligibleAfterComplaint", true);

// integers (Long) - stored as numbers, not strings
setDefault("subsidyAmount", java.lang.Long.valueOf(5000));
setDefault("originalSubmissionStart", java.lang.Long.valueOf(10));
setDefault("evaluationStart", java.lang.Long.valueOf(4));
setDefault("extraInformationStart", java.lang.Long.valueOf(4));
setDefault("complaintStart", java.lang.Long.valueOf(4));
setDefault("submissionDuration", java.lang.Long.valueOf(3));
setDefault("evaluationDuration", java.lang.Long.valueOf(3));
setDefault("extraInformationDuration", java.lang.Long.valueOf(3));
setDefault("complaintDuration", java.lang.Long.valueOf(3));</camunda:script>
        </camunda:executionListener>
      </bpmn:extensionElements>
      <bpmn:outgoing>Flow_Start_Beoordeling</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:serviceTask id="beoordeling" name="Beoordeling" camunda:type="external" camunda:topic="beoordeling">
      <bpmn:incoming>Flow_1hrnw7y</bpmn:incoming>
      <bpmn:incoming>Flow_ExtraInfo_Merge</bpmn:incoming>
      <bpmn:outgoing>Flow_Beoordeling_ExtraInfoGw</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="Gateway_ExtraInfo" name="extra informatie nodig?" default="Flow_ExtraInfoGw_Merge">
      <bpmn:incoming>Flow_Beoordeling_ExtraInfoGw</bpmn:incoming>
      <bpmn:outgoing>Flow_ExtraInfoGw_ExtraInfo</bpmn:outgoing>
      <bpmn:outgoing>Flow_ExtraInfoGw_Merge</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="informatie" name="Extra informatie aanvragen" camunda:type="external" camunda:topic="extra-informatie">
      <bpmn:incoming>Flow_ExtraInfoGw_ExtraInfo</bpmn:incoming>
      <bpmn:outgoing>Flow_ExtraInfo_Merge</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="Gateway_Bezwaar" name="bezwaar?" default="Flow_BezwaarGw_End">
      <bpmn:incoming>Flow_0ej5v72</bpmn:incoming>
      <bpmn:outgoing>Flow_BezwaarGw_Bezwaar</bpmn:outgoing>
      <bpmn:outgoing>Flow_BezwaarGw_End</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="bezwaar" name="Bezwaar behandelen" camunda:type="external" camunda:topic="bezwaar">
      <bpmn:incoming>Flow_BezwaarGw_Bezwaar</bpmn:incoming>
      <bpmn:outgoing>Flow_Bezwaar_End</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="klaar" name="klaar">
      <bpmn:incoming>Flow_BezwaarGw_End</bpmn:incoming>
      <bpmn:incoming>Flow_Bezwaar_End</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_Start_Beoordeling" sourceRef="start" targetRef="ingediend" />
    <bpmn:sequenceFlow id="Flow_Beoordeling_ExtraInfoGw" sourceRef="beoordeling" targetRef="Gateway_ExtraInfo" />
    <bpmn:sequenceFlow id="Flow_ExtraInfoGw_ExtraInfo" name="ja" sourceRef="Gateway_ExtraInfo" targetRef="informatie">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${needsExtraInformation}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_ExtraInfoGw_Merge" name="nee" sourceRef="Gateway_ExtraInfo" targetRef="afronden" />
    <bpmn:sequenceFlow id="Flow_ExtraInfo_Merge" name="terug naar beoordeling" sourceRef="informatie" targetRef="beoordeling" />
    <bpmn:sequenceFlow id="Flow_BezwaarGw_Bezwaar" name="ja" sourceRef="Gateway_Bezwaar" targetRef="bezwaar">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${willComplain}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_BezwaarGw_End" name="nee" sourceRef="Gateway_Bezwaar" targetRef="klaar" />
    <bpmn:sequenceFlow id="Flow_Bezwaar_End" sourceRef="bezwaar" targetRef="klaar" />
    <bpmn:serviceTask id="ingediend" name="ingediend" camunda:type="external" camunda:topic="ingediend">
      <bpmn:incoming>Flow_Start_Beoordeling</bpmn:incoming>
      <bpmn:outgoing>Flow_1hrnw7y</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="Flow_1hrnw7y" sourceRef="ingediend" targetRef="beoordeling" />
    <bpmn:sequenceFlow id="Flow_0ej5v72" sourceRef="afronden" targetRef="Gateway_Bezwaar" />
    <bpmn:serviceTask id="afronden" name="afronden beoordeling">
      <bpmn:incoming>Flow_ExtraInfoGw_Merge</bpmn:incoming>
      <bpmn:outgoing>Flow_0ej5v72</bpmn:outgoing>
    </bpmn:serviceTask>
  </bpmn:process>
