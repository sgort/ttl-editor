<?xml version='1.0' encoding='UTF-8'?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:camunda="http://camunda.org/schema/1.0/bpmn" id="Definitions_SubsidyProcess" targetNamespace="http://open-regels.nl/bpmn/subsidy" exporter="ChatGPT" exporterVersion="1.0">

  <bpmn:message id="Message_AdditionalInformationReceived" name="AdditionalInformationReceived"/>
  <bpmn:message id="Message_ComplaintReceived" name="ComplaintReceived"/>
  <bpmn:message id="Message_BudgetOrComplaintChanged" name="BudgetOrComplaintChanged"/>
  <bpmn:message id="Message_CompletenessOutcomeProvided" name="CompletenessOutcomeProvided"/>
  <bpmn:message id="Message_EligibilityOutcomeProvided" name="EligibilityOutcomeProvided"/>
  <bpmn:message id="Message_AmountOutcomeProvided" name="AmountOutcomeProvided"/>
  <bpmn:message id="Message_PayoutOutcomeProvided" name="PayoutOutcomeProvided"/>
  <bpmn:message id="Message_ComplaintOutcomeProvided" name="ComplaintOutcomeProvided"/>

  <bpmn:process id="SubsidyApplicationProcess" name="Subsidy application: request, extra information, rejection, complaint and payout" isExecutable="true" camunda:historyTimeToLive="180">
    <bpmn:documentation>
      Camunda 7 passive design for a subsidy process. A request is registered, budget is reserved, extra information can be requested, the case is accepted or rejected, rejected applicants may file a complaint, and complaint reserves are held separately until the complaint is resolved. This version does not call DMNs. Instead, the process waits at explicit message catch events. An external REST/API client reads the process variables, calculates or decides externally, updates variables, and correlates the matching message to continue the process. Payout is checked in first-come-first-served order, using the original submission date except where an extra-information subprocess changes the payout queue position to the date the missing information was received.
    </bpmn:documentation>

    <bpmn:startEvent id="StartEvent_RequestReceived" name="Subsidy request received"/>

    <bpmn:serviceTask id="Task_RegisterRequest" name="Register request" camunda:type="external" camunda:topic="subsidy-register"/>
    <bpmn:serviceTask id="Task_CreateRegularReserve" name="Reserve requested amount as regular hold" camunda:type="external" camunda:topic="budget-reserve-regular"/>

    <bpmn:intermediateCatchEvent id="Task_CheckCompleteness" name="Wait for completeness variables">
      <bpmn:documentation>Passive REST/API decision point. External client should set at least needsExtraInformation=false/true. Optional variables: completenessResult, missingInformationReason, requestedInformationList.</bpmn:documentation>
      <bpmn:messageEventDefinition messageRef="Message_CompletenessOutcomeProvided"/>
    </bpmn:intermediateCatchEvent>
    <bpmn:exclusiveGateway id="Gateway_NeedsExtraInfo" name="Need extra information?" default="Flow_NoExtraInfoNeeded"/>

    <bpmn:callActivity id="CallActivity_RequestExtraInfo" name="Request extra information subprocess" calledElement="RequestAdditionalInformationSubprocess">
      <bpmn:extensionElements>
        <camunda:in variables="all"/>
        <camunda:out variables="all"/>
      </bpmn:extensionElements>
    </bpmn:callActivity>
    <bpmn:exclusiveGateway id="Gateway_ExtraInfoReceived" name="Extra information received?" default="Flow_InfoNotReceived"/>

    <bpmn:intermediateCatchEvent id="Task_AssessEligibility" name="Wait for eligibility variables">
      <bpmn:documentation>Passive REST/API decision point. External client should set eligible=false/true. Optional variables: eligibilityResult, rejectionReason, legalGrounds.</bpmn:documentation>
      <bpmn:messageEventDefinition messageRef="Message_EligibilityOutcomeProvided"/>
    </bpmn:intermediateCatchEvent>
    <bpmn:exclusiveGateway id="Gateway_Eligible" name="Eligible?" default="Flow_NotEligible"/>

    <bpmn:intermediateCatchEvent id="Task_CalculateAmount" name="Wait for subsidy amount variables">
      <bpmn:documentation>Passive REST/API calculation point. External client should set subsidyAmount. Optional variables: amountResult, requestedAmount, calculatedBasisAmount, availableSubsidyCeiling.</bpmn:documentation>
      <bpmn:messageEventDefinition messageRef="Message_AmountOutcomeProvided"/>
    </bpmn:intermediateCatchEvent>
    <bpmn:serviceTask id="Task_SetPayoutQueuePosition" name="Set payout queue position" camunda:type="external" camunda:topic="payout-queue-position"/>
    <bpmn:intermediateCatchEvent id="Task_CheckPayoutQueue" name="Wait for payout outcome variables">
      <bpmn:documentation>Passive REST/API payout check. External client should set payoutStatus to AVAILABLE, BLOCKED, or EXHAUSTED. Optional variables: payoutResult, payoutQueueDate, budgetShortfall, blockingRequestId.</bpmn:documentation>
      <bpmn:messageEventDefinition messageRef="Message_PayoutOutcomeProvided"/>
    </bpmn:intermediateCatchEvent>
    <bpmn:exclusiveGateway id="Gateway_PayoutOutcome" name="Payout possible?" default="Flow_PayoutBlocked"/>

    <bpmn:intermediateCatchEvent id="Event_WaitBudgetOrComplaintChange" name="Wait for earlier complaint / budget change">
      <bpmn:messageEventDefinition messageRef="Message_BudgetOrComplaintChanged"/>
    </bpmn:intermediateCatchEvent>
    <bpmn:serviceTask id="Task_PaySubsidy" name="Accept, deduct budget and pay subsidy" camunda:type="external" camunda:topic="subsidy-pay"/>
    <bpmn:endEvent id="EndEvent_AcceptedPaid" name="Accepted and paid"/>

    <bpmn:serviceTask id="Task_RecordAcceptedUnpaid" name="Record accepted but not paid: budget exhausted" camunda:type="external" camunda:topic="subsidy-accepted-unpaid"/>
    <bpmn:endEvent id="EndEvent_AcceptedUnpaid" name="Accepted, payment impossible"/>

    <bpmn:serviceTask id="Task_PrepareRejection" name="Prepare rejection decision" camunda:type="external" camunda:topic="subsidy-rejection-prepare"/>
    <bpmn:serviceTask id="Task_SendRejection" name="Send rejection and complaint instructions" camunda:type="external" camunda:topic="subsidy-rejection-send"/>
    <bpmn:eventBasedGateway id="Gateway_WaitForComplaint" name="Complaint filed in time?"/>
    <bpmn:intermediateCatchEvent id="Event_ComplaintReceived" name="Complaint received">
      <bpmn:messageEventDefinition messageRef="Message_ComplaintReceived"/>
    </bpmn:intermediateCatchEvent>
    <bpmn:intermediateCatchEvent id="Event_ComplaintDeadlineExpired" name="Complaint period expired">
      <bpmn:timerEventDefinition>
        <bpmn:timeDuration xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:type="bpmn:tFormalExpression">${complaintDeadlineDuration}</bpmn:timeDuration>
      </bpmn:timerEventDefinition>
    </bpmn:intermediateCatchEvent>

    <bpmn:serviceTask id="Task_ReleaseRegularReserve" name="Release regular reserve" camunda:type="external" camunda:topic="budget-release-regular"/>
    <bpmn:endEvent id="EndEvent_RejectedFinal" name="Rejected: no complaint"/>

    <bpmn:serviceTask id="Task_MoveToComplaintReserve" name="Move hold to complaint reserve" camunda:type="external" camunda:topic="budget-reserve-complaint"/>
    <bpmn:callActivity id="CallActivity_HandleComplaint" name="Complaint handling subprocess" calledElement="HandleComplaintSubprocess">
      <bpmn:extensionElements>
        <camunda:in variables="all"/>
        <camunda:out variables="all"/>
      </bpmn:extensionElements>
    </bpmn:callActivity>
    <bpmn:exclusiveGateway id="Gateway_ComplaintUpheld" name="Complaint upheld?" default="Flow_ComplaintRefused"/>
    <bpmn:serviceTask id="Task_RestoreOriginalQueuePosition" name="Restore original payout queue position" camunda:type="external" camunda:topic="payout-queue-restore-original"/>
    <bpmn:serviceTask id="Task_ReleaseComplaintReserve" name="Release complaint reserve" camunda:type="external" camunda:topic="budget-release-complaint"/>
    <bpmn:endEvent id="EndEvent_RejectedAfterComplaint" name="Rejected after complaint"/>

    <bpmn:sequenceFlow id="Flow_1" sourceRef="StartEvent_RequestReceived" targetRef="Task_RegisterRequest"/>
    <bpmn:sequenceFlow id="Flow_2" sourceRef="Task_RegisterRequest" targetRef="Task_CreateRegularReserve"/>
    <bpmn:sequenceFlow id="Flow_3" sourceRef="Task_CreateRegularReserve" targetRef="Task_CheckCompleteness"/>
    <bpmn:sequenceFlow id="Flow_4" sourceRef="Task_CheckCompleteness" targetRef="Gateway_NeedsExtraInfo"/>
    <bpmn:sequenceFlow id="Flow_ExtraInfoNeeded" sourceRef="Gateway_NeedsExtraInfo" targetRef="CallActivity_RequestExtraInfo">
      <bpmn:conditionExpression xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:type="bpmn:tFormalExpression">${needsExtraInformation == true}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_NoExtraInfoNeeded" sourceRef="Gateway_NeedsExtraInfo" targetRef="Task_AssessEligibility"/>
    <bpmn:sequenceFlow id="Flow_ExtraInfoDone" sourceRef="CallActivity_RequestExtraInfo" targetRef="Gateway_ExtraInfoReceived"/>
    <bpmn:sequenceFlow id="Flow_InfoReceived" sourceRef="Gateway_ExtraInfoReceived" targetRef="Task_AssessEligibility">
      <bpmn:conditionExpression xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:type="bpmn:tFormalExpression">${additionalInformationReceived == true}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_InfoNotReceived" sourceRef="Gateway_ExtraInfoReceived" targetRef="Task_PrepareRejection"/>
    <bpmn:sequenceFlow id="Flow_EligibilityChecked" sourceRef="Task_AssessEligibility" targetRef="Gateway_Eligible"/>
    <bpmn:sequenceFlow id="Flow_Eligible" sourceRef="Gateway_Eligible" targetRef="Task_CalculateAmount">
      <bpmn:conditionExpression xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:type="bpmn:tFormalExpression">${eligible == true}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_NotEligible" sourceRef="Gateway_Eligible" targetRef="Task_PrepareRejection"/>
    <bpmn:sequenceFlow id="Flow_AmountCalculated" sourceRef="Task_CalculateAmount" targetRef="Task_SetPayoutQueuePosition"/>
    <bpmn:sequenceFlow id="Flow_QueueSet" sourceRef="Task_SetPayoutQueuePosition" targetRef="Task_CheckPayoutQueue"/>
    <bpmn:sequenceFlow id="Flow_PayoutChecked" sourceRef="Task_CheckPayoutQueue" targetRef="Gateway_PayoutOutcome"/>
    <bpmn:sequenceFlow id="Flow_PayoutAvailable" sourceRef="Gateway_PayoutOutcome" targetRef="Task_PaySubsidy">
      <bpmn:conditionExpression xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:type="bpmn:tFormalExpression">${payoutStatus == 'AVAILABLE'}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_PayoutExhausted" sourceRef="Gateway_PayoutOutcome" targetRef="Task_RecordAcceptedUnpaid">
      <bpmn:conditionExpression xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:type="bpmn:tFormalExpression">${payoutStatus == 'EXHAUSTED'}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_PayoutBlocked" sourceRef="Gateway_PayoutOutcome" targetRef="Event_WaitBudgetOrComplaintChange"/>
    <bpmn:sequenceFlow id="Flow_RecheckPayout" sourceRef="Event_WaitBudgetOrComplaintChange" targetRef="Task_CheckPayoutQueue"/>
    <bpmn:sequenceFlow id="Flow_Paid" sourceRef="Task_PaySubsidy" targetRef="EndEvent_AcceptedPaid"/>
    <bpmn:sequenceFlow id="Flow_RecordUnpaid" sourceRef="Task_RecordAcceptedUnpaid" targetRef="EndEvent_AcceptedUnpaid"/>
    <bpmn:sequenceFlow id="Flow_PrepareToSendRejection" sourceRef="Task_PrepareRejection" targetRef="Task_SendRejection"/>
    <bpmn:sequenceFlow id="Flow_RejectionSent" sourceRef="Task_SendRejection" targetRef="Gateway_WaitForComplaint"/>
    <bpmn:sequenceFlow id="Flow_ComplaintReceived" sourceRef="Gateway_WaitForComplaint" targetRef="Event_ComplaintReceived"/>
    <bpmn:sequenceFlow id="Flow_ComplaintDeadline" sourceRef="Gateway_WaitForComplaint" targetRef="Event_ComplaintDeadlineExpired"/>
    <bpmn:sequenceFlow id="Flow_NoComplaintRelease" sourceRef="Event_ComplaintDeadlineExpired" targetRef="Task_ReleaseRegularReserve"/>
    <bpmn:sequenceFlow id="Flow_NoComplaintEnd" sourceRef="Task_ReleaseRegularReserve" targetRef="EndEvent_RejectedFinal"/>
    <bpmn:sequenceFlow id="Flow_MoveReserve" sourceRef="Event_ComplaintReceived" targetRef="Task_MoveToComplaintReserve"/>
    <bpmn:sequenceFlow id="Flow_ComplaintSubprocess" sourceRef="Task_MoveToComplaintReserve" targetRef="CallActivity_HandleComplaint"/>
    <bpmn:sequenceFlow id="Flow_ComplaintHandled" sourceRef="CallActivity_HandleComplaint" targetRef="Gateway_ComplaintUpheld"/>
    <bpmn:sequenceFlow id="Flow_ComplaintUpheld" sourceRef="Gateway_ComplaintUpheld" targetRef="Task_RestoreOriginalQueuePosition">
      <bpmn:conditionExpression xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:type="bpmn:tFormalExpression">${complaintUpheld == true}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_AppealBackToPayout" sourceRef="Task_RestoreOriginalQueuePosition" targetRef="Task_CheckPayoutQueue"/>
    <bpmn:sequenceFlow id="Flow_ComplaintRefused" sourceRef="Gateway_ComplaintUpheld" targetRef="Task_ReleaseComplaintReserve"/>
    <bpmn:sequenceFlow id="Flow_ComplaintRefusedEnd" sourceRef="Task_ReleaseComplaintReserve" targetRef="EndEvent_RejectedAfterComplaint"/>
  </bpmn:process>

  <bpmn:process id="RequestAdditionalInformationSubprocess" name="Request additional information" isExecutable="true" camunda:historyTimeToLive="180">
    <bpmn:startEvent id="StartEvent_InfoRequest" name="Extra information needed"/>
    <bpmn:serviceTask id="Task_SendInfoRequest" name="Send request for additional information" camunda:type="external" camunda:topic="additional-info-request-send"/>
    <bpmn:eventBasedGateway id="Gateway_WaitAdditionalInfo" name="Wait for applicant"/>
    <bpmn:intermediateCatchEvent id="Event_AdditionalInfoReceived" name="Additional information received">
      <bpmn:messageEventDefinition messageRef="Message_AdditionalInformationReceived"/>
    </bpmn:intermediateCatchEvent>
    <bpmn:intermediateCatchEvent id="Event_InfoDeadlineExpired" name="Information deadline expired">
      <bpmn:timerEventDefinition>
        <bpmn:timeDuration xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:type="bpmn:tFormalExpression">${extraInformationDeadlineDuration}</bpmn:timeDuration>
      </bpmn:timerEventDefinition>
    </bpmn:intermediateCatchEvent>
    <bpmn:userTask id="UserTask_ReviewAdditionalInfo" name="Review received information" camunda:assignee="${caseworker}"/>
    <bpmn:serviceTask id="Task_SetInfoReceived" name="Set additionalInformationReceived = true" camunda:type="external" camunda:topic="additional-info-received"/>
    <bpmn:endEvent id="EndEvent_InfoCompleted" name="Information complete"/>
    <bpmn:serviceTask id="Task_SetInfoMissing" name="Set additionalInformationReceived = false" camunda:type="external" camunda:topic="additional-info-missing"/>
    <bpmn:endEvent id="EndEvent_InfoMissing" name="Information missing"/>
    <bpmn:sequenceFlow id="InfoFlow_1" sourceRef="StartEvent_InfoRequest" targetRef="Task_SendInfoRequest"/>
    <bpmn:sequenceFlow id="InfoFlow_2" sourceRef="Task_SendInfoRequest" targetRef="Gateway_WaitAdditionalInfo"/>
    <bpmn:sequenceFlow id="InfoFlow_Received" sourceRef="Gateway_WaitAdditionalInfo" targetRef="Event_AdditionalInfoReceived"/>
    <bpmn:sequenceFlow id="InfoFlow_Timeout" sourceRef="Gateway_WaitAdditionalInfo" targetRef="Event_InfoDeadlineExpired"/>
    <bpmn:sequenceFlow id="InfoFlow_Review" sourceRef="Event_AdditionalInfoReceived" targetRef="UserTask_ReviewAdditionalInfo"/>
    <bpmn:sequenceFlow id="InfoFlow_SetReceived" sourceRef="UserTask_ReviewAdditionalInfo" targetRef="Task_SetInfoReceived"/>
    <bpmn:sequenceFlow id="InfoFlow_EndReceived" sourceRef="Task_SetInfoReceived" targetRef="EndEvent_InfoCompleted"/>
    <bpmn:sequenceFlow id="InfoFlow_SetMissing" sourceRef="Event_InfoDeadlineExpired" targetRef="Task_SetInfoMissing"/>
    <bpmn:sequenceFlow id="InfoFlow_EndMissing" sourceRef="Task_SetInfoMissing" targetRef="EndEvent_InfoMissing"/>
  </bpmn:process>

  <bpmn:process id="HandleComplaintSubprocess" name="Handle complaint" isExecutable="true" camunda:historyTimeToLive="180">
    <bpmn:startEvent id="StartEvent_Complaint" name="Complaint filed"/>
    <bpmn:serviceTask id="Task_RegisterComplaint" name="Register complaint" camunda:type="external" camunda:topic="complaint-register"/>
    <bpmn:serviceTask id="Task_ConfirmComplaintReserve" name="Confirm budget remains reserved as complaint hold" camunda:type="external" camunda:topic="complaint-reserve-confirm"/>
    <bpmn:userTask id="UserTask_ReviewComplaint" name="Review complaint" camunda:assignee="${complaintOfficer}"/>
    <bpmn:intermediateCatchEvent id="Event_ComplaintProcessingTime" name="Complaint processing time">
      <bpmn:timerEventDefinition>
        <bpmn:timeDuration xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:type="bpmn:tFormalExpression">${complaintProcessingDuration}</bpmn:timeDuration>
      </bpmn:timerEventDefinition>
    </bpmn:intermediateCatchEvent>
    <bpmn:intermediateCatchEvent id="Task_DecideComplaint" name="Wait for complaint outcome variables">
      <bpmn:documentation>Passive REST/API complaint decision point. External client should set complaintUpheld=false/true. Optional variables: complaintResult, complaintReason, revisedEligibility, revisedSubsidyAmount.</bpmn:documentation>
      <bpmn:messageEventDefinition messageRef="Message_ComplaintOutcomeProvided"/>
    </bpmn:intermediateCatchEvent>
    <bpmn:endEvent id="EndEvent_ComplaintResolved" name="Complaint resolved"/>
    <bpmn:sequenceFlow id="ComplaintFlow_1" sourceRef="StartEvent_Complaint" targetRef="Task_RegisterComplaint"/>
    <bpmn:sequenceFlow id="ComplaintFlow_2" sourceRef="Task_RegisterComplaint" targetRef="Task_ConfirmComplaintReserve"/>
    <bpmn:sequenceFlow id="ComplaintFlow_3" sourceRef="Task_ConfirmComplaintReserve" targetRef="UserTask_ReviewComplaint"/>
    <bpmn:sequenceFlow id="ComplaintFlow_4" sourceRef="UserTask_ReviewComplaint" targetRef="Event_ComplaintProcessingTime"/>
    <bpmn:sequenceFlow id="ComplaintFlow_5" sourceRef="Event_ComplaintProcessingTime" targetRef="Task_DecideComplaint"/>
    <bpmn:sequenceFlow id="ComplaintFlow_6" sourceRef="Task_DecideComplaint" targetRef="EndEvent_ComplaintResolved"/>
  </bpmn:process>

  <bpmndi:BPMNDiagram id="BPMNDiagram_SubsidyProcess">
    <bpmndi:BPMNPlane id="BPMNPlane_SubsidyProcess" bpmnElement="SubsidyApplicationProcess">
      <bpmndi:BPMNShape id="Shape_StartEvent_RequestReceived" bpmnElement="StartEvent_RequestReceived"><dc:Bounds x="100" y="222" width="36" height="36"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Task_RegisterRequest" bpmnElement="Task_RegisterRequest"><dc:Bounds x="175" y="200" width="130" height="80"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Task_CreateRegularReserve" bpmnElement="Task_CreateRegularReserve"><dc:Bounds x="345" y="200" width="150" height="80"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Task_CheckCompleteness" bpmnElement="Task_CheckCompleteness"><dc:Bounds x="602" y="222" width="36" height="36"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Gateway_NeedsExtraInfo" bpmnElement="Gateway_NeedsExtraInfo" isMarkerVisible="true"><dc:Bounds x="755" y="215" width="50" height="50"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_CallActivity_RequestExtraInfo" bpmnElement="CallActivity_RequestExtraInfo"><dc:Bounds x="735" y="330" width="150" height="80"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Gateway_ExtraInfoReceived" bpmnElement="Gateway_ExtraInfoReceived" isMarkerVisible="true"><dc:Bounds x="940" y="345" width="50" height="50"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Task_AssessEligibility" bpmnElement="Task_AssessEligibility"><dc:Bounds x="987" y="222" width="36" height="36"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Gateway_Eligible" bpmnElement="Gateway_Eligible" isMarkerVisible="true"><dc:Bounds x="1125" y="215" width="50" height="50"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Task_CalculateAmount" bpmnElement="Task_CalculateAmount"><dc:Bounds x="1282" y="222" width="36" height="36"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Task_SetPayoutQueuePosition" bpmnElement="Task_SetPayoutQueuePosition"><dc:Bounds x="1425" y="200" width="150" height="80"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Task_CheckPayoutQueue" bpmnElement="Task_CheckPayoutQueue"><dc:Bounds x="1682" y="222" width="36" height="36"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Gateway_PayoutOutcome" bpmnElement="Gateway_PayoutOutcome" isMarkerVisible="true"><dc:Bounds x="1825" y="215" width="50" height="50"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Event_WaitBudgetOrComplaintChange" bpmnElement="Event_WaitBudgetOrComplaintChange"><dc:Bounds x="1832" y="95" width="36" height="36"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Task_PaySubsidy" bpmnElement="Task_PaySubsidy"><dc:Bounds x="1930" y="200" width="150" height="80"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_EndEvent_AcceptedPaid" bpmnElement="EndEvent_AcceptedPaid"><dc:Bounds x="2125" y="222" width="36" height="36"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Task_RecordAcceptedUnpaid" bpmnElement="Task_RecordAcceptedUnpaid"><dc:Bounds x="1930" y="320" width="165" height="80"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_EndEvent_AcceptedUnpaid" bpmnElement="EndEvent_AcceptedUnpaid"><dc:Bounds x="2140" y="342" width="36" height="36"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Task_PrepareRejection" bpmnElement="Task_PrepareRejection"><dc:Bounds x="1125" y="480" width="150" height="80"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Task_SendRejection" bpmnElement="Task_SendRejection"><dc:Bounds x="1325" y="480" width="165" height="80"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Gateway_WaitForComplaint" bpmnElement="Gateway_WaitForComplaint"><dc:Bounds x="1545" y="495" width="50" height="50"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Event_ComplaintReceived" bpmnElement="Event_ComplaintReceived"><dc:Bounds x="1662" y="430" width="36" height="36"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Event_ComplaintDeadlineExpired" bpmnElement="Event_ComplaintDeadlineExpired"><dc:Bounds x="1662" y="585" width="36" height="36"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Task_ReleaseRegularReserve" bpmnElement="Task_ReleaseRegularReserve"><dc:Bounds x="1745" y="565" width="150" height="80"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_EndEvent_RejectedFinal" bpmnElement="EndEvent_RejectedFinal"><dc:Bounds x="1945" y="587" width="36" height="36"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Task_MoveToComplaintReserve" bpmnElement="Task_MoveToComplaintReserve"><dc:Bounds x="1745" y="405" width="155" height="80"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_CallActivity_HandleComplaint" bpmnElement="CallActivity_HandleComplaint"><dc:Bounds x="1950" y="405" width="150" height="80"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Gateway_ComplaintUpheld" bpmnElement="Gateway_ComplaintUpheld" isMarkerVisible="true"><dc:Bounds x="2150" y="420" width="50" height="50"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Task_RestoreOriginalQueuePosition" bpmnElement="Task_RestoreOriginalQueuePosition"><dc:Bounds x="2250" y="340" width="170" height="80"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Task_ReleaseComplaintReserve" bpmnElement="Task_ReleaseComplaintReserve"><dc:Bounds x="2250" y="500" width="160" height="80"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_EndEvent_RejectedAfterComplaint" bpmnElement="EndEvent_RejectedAfterComplaint"><dc:Bounds x="2455" y="522" width="36" height="36"/></bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="Edge_Flow_1" bpmnElement="Flow_1">
        <di:waypoint x="136" y="240"/>
        <di:waypoint x="175" y="240"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_Flow_2" bpmnElement="Flow_2">
        <di:waypoint x="305" y="240"/>
        <di:waypoint x="345" y="240"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_Flow_3" bpmnElement="Flow_3">
        <di:waypoint x="495" y="240"/>
        <di:waypoint x="602" y="240"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_Flow_4" bpmnElement="Flow_4">
        <di:waypoint x="638" y="240"/>
