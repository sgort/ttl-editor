        </inputEntry>
        <inputEntry id="UnaryTests_1kff300">
          <text></text>
        </inputEntry>
        <outputEntry id="LiteralExpression_18fm3qf">
          <text></text>
        </outputEntry>
      </rule>
      <rule id="DecisionRule_1dqlhxp">
        <inputEntry id="UnaryTests_07tmdvy">
          <text></text>
        </inputEntry>
        <inputEntry id="UnaryTests_13zu4uc">
