          <text></text>
        </outputEntry>
      </rule>
    </decisionTable>
  </decision>
  <decision id="SubsidieConstantenThuisbatterij" name="Subsidie Constanten Thuisbatterij" camunda:historyTimeToLive="0">
    <variable name="constanten" />
    <decisionTable id="DecisionTable_SubsidieConstantenThuisbatterij">
      <output id="Output_Constanten_SubsidiePercentage" label="Subsidiepercentage" name="subsidiePercentage" typeRef="double" />
      <output id="Output_Constanten_SubsidieMinimum" label="Subsidie minimum" name="subsidieMinimum" typeRef="double" />
      <output id="Output_Constanten_SubsidieMaximum" label="Subsidie maximum" name="subsidieMaximum" typeRef="double" />
      <output id="Output_Constanten_MinimaleNoodzakelijkeKosten" label="Minimale noodzakelijke kosten" name="minimaleNoodzakelijkeKosten" typeRef="double" />
      <rule id="Rule_Constanten_Standaard">
        <outputEntry id="LiteralExpression_Constanten_subsidiePercentage" expressionLanguage="feel">
          <text>0.25</text>
        </outputEntry>
        <outputEntry id="LiteralExpression_Constanten_subsidieMinimum" expressionLanguage="feel">
          <text>750</text>
        </outputEntry>
        <outputEntry id="LiteralExpression_Constanten_subsidieMaximum" expressionLanguage="feel">
          <text>1250</text>
        </outputEntry>
        <outputEntry id="LiteralExpression_Constanten_minimaleNoodzakelijkeKosten" expressionLanguage="feel">
          <text>750</text>
        </outputEntry>
      </rule>
    </decisionTable>
  </decision>
  <decision id="jaarGebondenBudget" name="Jaar Gebonden Budget" camunda:historyTimeToLive="0">
    <informationRequirement id="InformationRequirement_1wmmpy6">
      <requiredInput href="#InputData_0w9g4pp" />
    </informationRequirement>
    <decisionTable id="DecisionTable_1bhjh1w">
      <input id="InputClause_17k6w47" label="aanvraagjaar">
        <inputExpression id="LiteralExpression_0nh2bq6" typeRef="integer" expressionLanguage="feel">
          <text>date(aanvraagDatum).year</text>
        </inputExpression>
      </input>
      <output id="OutputClause_0yimwls" label="Plafond Eigenaren" name="plafondEigenaren" typeRef="double" />
      <output id="OutputClause_0u2e23j" label="Plafond Huurders" name="plafondHuurders" typeRef="double" />
      <rule id="DecisionRule_0nfr6kl">
        <inputEntry id="UnaryTests_1r47gy9">
          <text>2026</text>
        </inputEntry>
        <outputEntry id="LiteralExpression_1v1foh0">
          <text>437500</text>
        </outputEntry>
        <outputEntry id="LiteralExpression_1k8pkv5">
          <text>437500</text>
        </outputEntry>
      </rule>
      <rule id="DecisionRule_1e5agpr">
        <inputEntry id="UnaryTests_0gqxupk">
          <text>2027</text>
        </inputEntry>
        <outputEntry id="LiteralExpression_1g4q0rk">
          <text>437500</text>
        </outputEntry>
        <outputEntry id="LiteralExpression_1wjnld3">
          <text>437500</text>
        </outputEntry>
      </rule>
    </decisionTable>
  </decision>
