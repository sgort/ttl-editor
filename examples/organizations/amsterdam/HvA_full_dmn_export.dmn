			<dmn:decisionTable hitPolicy="FIRST" id="_6041f4d4-35e8-4377-993d-5b2a879c31e4_table" outputLabel="aanspraak op een Stadspas" typeRef="boolean">
				<dmn:input>
					<dmn:inputExpression typeRef="boolean">
						<dmn:text>natuurlijke persoon.woonachtig in de gemeente waar wordt aangevraagd</dmn:text>
					</dmn:inputExpression>
				</dmn:input>
				<dmn:input>
					<dmn:inputExpression typeRef="boolean">
						<dmn:text>natuurlijke persoon.meerderjarig</dmn:text>
					</dmn:inputExpression>
				</dmn:input>
				<dmn:input>
					<dmn:inputExpression typeRef="string">
						<dmn:text>natuurlijke persoon.burgerservicenummer</dmn:text>
					</dmn:inputExpression>
				</dmn:input>
				<dmn:input>
					<dmn:inputExpression typeRef="number">
						<dmn:text>natuurlijke persoon.fiscaal gezinsinkomen vorig jaar</dmn:text>
					</dmn:inputExpression>
				</dmn:input>
				<dmn:input>
					<dmn:inputExpression typeRef="number">
						<dmn:text>natuurlijke persoon.vermogen op 31 december vorig jaar</dmn:text>
					</dmn:inputExpression>
				</dmn:input>
				<dmn:input>
					<dmn:inputExpression typeRef="boolean">
						<dmn:text>natuurlijke persoon.een schuldregeling</dmn:text>
					</dmn:inputExpression>
				</dmn:input>
				<dmn:input>
					<dmn:inputExpression typeRef="boolean">
						<dmn:text>natuurlijke persoon.ontvangt voedselpakketten van Voedselbank Amsterdam of Voedselbank Gooi en Omstreken</dmn:text>
					</dmn:inputExpression>
				</dmn:input>
				<dmn:input>
					<dmn:inputExpression typeRef="boolean">
						<dmn:text>natuurlijke persoon.volgt onderwijs in de zin van hoofdstuk 4 van de Wet tegemoetkoming onderwijsbijdrage en schoolkosten</dmn:text>
					</dmn:inputExpression>
				</dmn:input>
				<dmn:input>
					<dmn:inputExpression typeRef="boolean">
