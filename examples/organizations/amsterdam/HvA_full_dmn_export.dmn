			<dmn:decisionTable hitPolicy="FIRST" id="_5ff6a88e-fea3-4dc7-8863-e1bf542f2513_table" outputLabel="aanspraak op bijzondere bijstand" typeRef="boolean">
				<dmn:input>
					<dmn:inputExpression typeRef="boolean">
						<dmn:text>natuurlijke persoon.bijzondere omstandigheden die leiden tot noodzakelijke kosten van bestaan die in Nederland zijn gemaakt en aan Nederland zijn verbonden</dmn:text>
					</dmn:inputExpression>
				</dmn:input>
				<dmn:input>
					<dmn:inputExpression typeRef="boolean">
						<dmn:text>natuurlijke persoon.financiele draagkracht</dmn:text>
					</dmn:inputExpression>
				</dmn:input>
				<dmn:input>
					<dmn:inputExpression typeRef="boolean">
						<dmn:text>natuurlijke persoon.verwacht dat die een lening aangaat</dmn:text>
					</dmn:inputExpression>
				</dmn:input>
				<dmn:input>
					<dmn:inputExpression typeRef="boolean">
						<dmn:text>natuurlijke persoon.verwacht dat er voor deze noodzakelijke kosten had gereserveerd</dmn:text>
					</dmn:inputExpression>
				</dmn:input>
				<dmn:input>
					<dmn:inputExpression typeRef="boolean">
						<dmn:text>natuurlijke persoon.kan beroep doen op een voorliggende voorziening _bijz. bijstand_</dmn:text>
					</dmn:inputExpression>
				</dmn:input>
				<dmn:input>
					<dmn:inputExpression typeRef="boolean">
						<dmn:text>natuurlijke persoon.kosten worden als niet noodzakelijk beschouwd door voorliggende voorziening</dmn:text>
					</dmn:inputExpression>
				</dmn:input>
				<dmn:input>
					<dmn:inputExpression typeRef="boolean">
						<dmn:text>natuurlijke persoon.kosten voor een buitengesloten kostenpost</dmn:text>
					</dmn:inputExpression>
				</dmn:input>
				<dmn:output label="aanspraak op bijzondere bijstand" typeRef="boolean"/>
				<dmn:rule> 
					<dmn:inputEntry>
						<dmn:text>true</dmn:text>
					</dmn:inputEntry>
					<dmn:inputEntry>
						<dmn:text>not -</dmn:text>
					</dmn:inputEntry>
					<dmn:inputEntry>
						<dmn:text>not -</dmn:text>
					</dmn:inputEntry>
					<dmn:inputEntry>
						<dmn:text>-</dmn:text>
					</dmn:inputEntry>
