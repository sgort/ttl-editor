			<dmn:decisionTable hitPolicy="FIRST" id="_a95ae1d9-eb21-4ef0-8e97-550cba6d5b27_table" outputLabel="aanspraak op pc-voorziening" typeRef="boolean">
				<dmn:input>
					<dmn:inputExpression typeRef="string">
						<dmn:text>natuurlijke persoon.burgerservicenummer</dmn:text>
					</dmn:inputExpression>
				</dmn:input>
				<dmn:input>
					<dmn:inputExpression typeRef="boolean">
						<dmn:text>kind.een beleidsregels minimakind</dmn:text>
					</dmn:inputExpression>
				</dmn:input>
				<dmn:input>
					<dmn:inputExpression typeRef="boolean">
						<dmn:text>kind.ingeschreven op basisschool</dmn:text>
					</dmn:inputExpression>
				</dmn:input>
				<dmn:input label="kind.leeftijd op peildatum">
					<dmn:inputExpression typeRef="number">
						<dmn:text>years(years and months duration(kind.geboortedatum, peildatum))</dmn:text>
					</dmn:inputExpression>
				</dmn:input>
				<dmn:input>
					<dmn:inputExpression typeRef="boolean">
						<dmn:text>kind.een broer of zus die in de afgelopen 4 jaar een pc-voorziening in het basisonderwijs heeft gekregen</dmn:text>
					</dmn:inputExpression>
				</dmn:input>
				<dmn:input>
					<dmn:inputExpression typeRef="boolean">
						<dmn:text>kind.ingeschreven op voorgezet onderwijs</dmn:text>
					</dmn:inputExpression>
				</dmn:input>
				<dmn:input>
					<dmn:inputExpression typeRef="boolean">
						<dmn:text>kind.in voorafgaand jaar in het basisonderwijs een pc-voorziening gekregen</dmn:text>
					</dmn:inputExpression>
				</dmn:input>
				<dmn:input>
					<dmn:inputExpression typeRef="boolean">
						<dmn:text>kind.in de voorafgaande 4 jaren in het voortgezetonderwijs een pc-voorziening gekregen</dmn:text>
					</dmn:inputExpression>
				</dmn:input>
				<dmn:output label="aanspraak op pc-voorziening" typeRef="boolean"/>
				<dmn:rule> 
					<dmn:inputEntry>
						<dmn:text>not(null) -</dmn:text>
					</dmn:inputEntry>
					<dmn:inputEntry>
						<dmn:text>true</dmn:text>
					</dmn:inputEntry>
					<dmn:inputEntry>
						<dmn:text>true</dmn:text>
					</dmn:inputEntry>
					<dmn:inputEntry>
						<dmn:text>&gt;= 10 and &lt;= 12</dmn:text>
					</dmn:inputEntry>
					<dmn:inputEntry>
						<dmn:text>not -</dmn:text>
					</dmn:inputEntry>
					<dmn:inputEntry>
						<dmn:text>-</dmn:text>
					</dmn:inputEntry>
					<dmn:inputEntry>
						<dmn:text>-</dmn:text>
					</dmn:inputEntry>
					<dmn:inputEntry>
						<dmn:text>-</dmn:text>
					</dmn:inputEntry>
					<dmn:outputEntry>
						<dmn:text>true</dmn:text>
					</dmn:outputEntry>
