			<dmn:decisionTable hitPolicy="FIRST" id="_5d364321-409e-432f-83f2-f04cc26035fc_table" outputLabel="aanspraak op individuele inkomenstoeslag" typeRef="boolean">
				<dmn:input>
					<dmn:inputExpression typeRef="boolean">
						<dmn:text>partner.woonachtig in gemeente waar wordt aangevraagd</dmn:text>
					</dmn:inputExpression>
				</dmn:input>
				<dmn:input label="partner.leeftijd op peildatum">
					<dmn:inputExpression typeRef="number">
						<dmn:text>years(years and months duration(partner.geboortedatum, peildatum))</dmn:text>
					</dmn:inputExpression>
				</dmn:input>
				<dmn:input>
					<dmn:inputExpression typeRef="boolean">
						<dmn:text>natuurlijke persoon.langdurig laag inkomen</dmn:text>
					</dmn:inputExpression>
				</dmn:input>
				<dmn:input>
					<dmn:inputExpression typeRef="number">
						<dmn:text>natuurlijke persoon.vermogen op 31 december vorig jaar</dmn:text>
					</dmn:inputExpression>
				</dmn:input>
				<dmn:input>
					<dmn:inputExpression typeRef="boolean">
						<dmn:text>natuurlijke persoon.een schuldregeling</dmn:text>
					</dmn:inputExpression>
				</dmn:input>
				<dmn:input>
					<dmn:inputExpression typeRef="boolean">
						<dmn:text>natuurlijke persoon.uitzicht op inkomensverbetering</dmn:text>
					</dmn:inputExpression>
				</dmn:input>
				<dmn:input>
					<dmn:inputExpression typeRef="boolean">
						<dmn:text>partner.uitzicht op inkomensverbetering</dmn:text>
					</dmn:inputExpression>
				</dmn:input>
				<dmn:output label="aanspraak op individuele inkomenstoeslag" typeRef="boolean"/>
				<dmn:rule> 
					<dmn:inputEntry>
						<dmn:text>true</dmn:text>
					</dmn:inputEntry>
					<dmn:inputEntry>
						<dmn:text>&gt;= 21 and &lt; pensioengerechtigde leeftijd</dmn:text>
					</dmn:inputEntry>
					<dmn:inputEntry>
						<dmn:text>true</dmn:text>
					</dmn:inputEntry>
					<dmn:inputEntry>
