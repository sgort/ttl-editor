  <dmn:decision id="_70476381-08ed-4db9-8602-edcc50341607" name="Beslistabel bepalen natuurlijke persoon is meerderjarig" camunda:historyTimeToLive="0">
    <dmn:variable id="_var_70476381-08ed-4db9-8602-edcc50341607" name="npMeerderjarig" typeRef="boolean" />
    <dmn:informationRequirement id="_ade43470-89c4-11f1-993f-efd32e7d47b1">
      <dmn:requiredInput href="#_ad4e19ea-89c4-11f1-9823-4bb64cf76dfb" />
    </dmn:informationRequirement>
    <dmn:informationRequirement id="_ade55f9e-89c4-11f1-9943-df62c7f3a350">
      <dmn:requiredInput href="#_ad4ed2b8-89c4-11f1-9825-8febbaebbc08" />
    </dmn:informationRequirement>
    <dmn:decisionTable id="_70476381-08ed-4db9-8602-edcc50341607_table" typeRef="boolean" hitPolicy="FIRST" outputLabel="meerderjarig">
      <dmn:input id="_input_110" label="natuurlijke persoon.leeftijd op peildatum">
        <dmn:inputExpression typeRef="number">
          <dmn:text>(years and months duration(npGeboortedatum, peildatum)).years</dmn:text>
