  <dmn:decision id="_912d27e0-1b8f-47bd-98cf-1863354ef321" name="Bepalen van toepassing zijnde vermogensgrens" camunda:historyTimeToLive="0">
    <dmn:informationRequirement id="_d1d032f0-748c-11f1-aced-b35680e8ab60">
      <dmn:requiredInput href="#_d1952ed0-748c-11f1-acba-1366718634c7" />
