      <dmn:input label="vorig jaar">
        <dmn:inputExpression typeRef="number">
          <dmn:text>berekeningsjaar-1</dmn:text>
        </dmn:inputExpression>
      </dmn:input>
      <dmn:input>
        <dmn:inputExpression typeRef="string">
          <dmn:text>natuurlijke persoon.gezinssituatie</dmn:text>
        </dmn:inputExpression>
      </dmn:input>
      <dmn:output label="van toepassing zijnde vermogensgrens" typeRef="number" />
      <dmn:rule>
        <dmn:inputEntry>
          <dmn:text>2024</dmn:text>
