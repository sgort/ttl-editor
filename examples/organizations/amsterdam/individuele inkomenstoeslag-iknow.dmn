    <dmn:decisionTable id="_bca439b7-fdb8-40e3-8a1d-3bb95571c65c_table" typeRef="boolean" hitPolicy="FIRST" outputLabel="aanspraak op individuele inkomenstoeslag">
      <dmn:input>
        <dmn:inputExpression typeRef="boolean">
          <dmn:text>natuurlijke persoon.woonachtig in de gemeente waar wordt aangevraagd</dmn:text>
        </dmn:inputExpression>
      </dmn:input>
      <dmn:input label="natuurlijke persoon.leeftijd op peildatum">
        <dmn:inputExpression typeRef="number">
          <dmn:text>years(years and months duration(natuurlijke persoon.geboortedatum, peildatum))</dmn:text>
        </dmn:inputExpression>
      </dmn:input>
      <dmn:input>
        <dmn:inputExpression typeRef="boolean">
          <dmn:text>natuurlijke persoon.uitzicht op inkomensverbetering</dmn:text>
        </dmn:inputExpression>
      </dmn:input>
      <dmn:input>
        <dmn:inputExpression typeRef="boolean">
          <dmn:text>natuurlijke persoon.langdurig laag inkomen</dmn:text>
        </dmn:inputExpression>
      </dmn:input>
      <dmn:input>
        <dmn:inputExpression typeRef="number">
          <dmn:text>natuurlijke persoon.vermogen op 31 december vorig jaar</dmn:text>
        </dmn:inputExpression>
      </dmn:input>
      <dmn:input>
        <dmn:inputExpression typeRef="boolean">
          <dmn:text>natuurlijke persoon.een schuldregeling</dmn:text>
        </dmn:inputExpression>
      </dmn:input>
      <dmn:input>
        <dmn:inputExpression typeRef="string">
          <dmn:text>natuurlijke persoon.gezinssituatie</dmn:text>
        </dmn:inputExpression>
      </dmn:input>
      <dmn:input>
        <dmn:inputExpression typeRef="boolean">
          <dmn:text>partner.uitzicht op inkomensverbetering</dmn:text>
        </dmn:inputExpression>
      </dmn:input>
      <dmn:output label="aanspraak op individuele inkomenstoeslag" typeRef="boolean" />
      <dmn:rule>
        <dmn:inputEntry>
          <dmn:text>true</dmn:text>
        </dmn:inputEntry>
        <dmn:inputEntry>
          <dmn:text>&gt;= 21 and &lt; pensioengerechtigde leeftijd</dmn:text>
        </dmn:inputEntry>
        <dmn:inputEntry>
          <dmn:text>false</dmn:text>
        </dmn:inputEntry>
