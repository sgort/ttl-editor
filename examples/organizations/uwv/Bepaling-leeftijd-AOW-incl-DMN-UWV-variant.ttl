# ============================================================
#  Temporal Rules
# ============================================================

<https://regels.overheid.nl/register/uwv/98a8bcb8-c4ff-4765-80ad-26778728abfb> a cpsv:Rule, cprmv:TemporalRule ;
    cpsv:implements <https://regels.overheid.nl/services/aow-leeftijd-uwv> ;
    dct:identifier "IAOW_00001_Berekenen_ingangsdatum_AOW" ;
    dct:title "Berekenen ingangsdatum AOW"@nl ;
    cprmv:validFrom "2025-02-01"^^xsd:date ;
    cprmv:confidenceLevel "high" ;
    dct:description "De begindatum van een recht op uitkering AOW moet worden berekend als A + B jaren + C maanden waarin geldt dat: \n•\tA = de geboortedatum van de natuurlijk persoon met het recht op uitkering AOW. \n•\tB = het aantal jaren van de pensioengerechtigde leeftijd van de natuurlijk persoon. \n•\tC = het aantal aanvullende maanden van de pensioengerechtigde leeftijd van de natuurlijk persoon.\n"@nl  .

<https://regels.overheid.nl/register/uwv/1ac92c1a-e90f-4f07-a3d3-8cbac25cd2d7> a cpsv:Rule, cprmv:TemporalRule ;
    cpsv:implements <https://regels.overheid.nl/services/aow-leeftijd-uwv> ;
    dct:identifier "Tabel_IAOW_00002_Bepalen_pensioengerechtigde_leeftijd" ;
    dct:title "Bepalen pensioengerechtigde leeftijd"@nl ;
    cprmv:extends <https://regels.overheid.nl/register/uwv/97c245be-252b-46c2-ba39-9d8676e99e10> ;
    cprmv:validFrom "2025-02-01"^^xsd:date ;
    cprmv:confidenceLevel "high" ;
    dct:description "Beslistabel:\t\nDe geboortedatum van de natuurlijk persoon met het recht op uitkering AOW. \tDe geboortedatum van de natuurlijk persoon met het recht op uitkering AOW. \tHet aantal jaren van de pensioengerechtigde leeftijd van de natuurlijk persoon. \tHet aantal aanvullende maanden van de pensioengerechtigde leeftijd van de natuurlijk persoon. \tDe pensioengerechtigde leeftijd van de natuurlijk persoon is definitief. \n- \t<= 31-12-1947 \t= 65 \t= 0 \t= Waar \n>= 01-01-1948 \t<= 30-11-1948 \t= 65 \t= 1 \t= Waar \n>= 01-12-1948 \t<= 31-10-1949 \t= 65 \t= 2 \t= Waar \n>= 01-11-1949 \t<= 30-09-1950 \t= 65 \t= 3 \t= Waar \n>= 01-10-1950 \t<= 30-06-1951 \t= 65 \t= 6 \t= Waar \n>= 01-07-1951 \t<= 31-03-1952 \t= 65 \t= 9 \t= Waar \n>= 01-04-1952 \t<= 31-12-1952 \t= 66 \t= 0 \t= Waar \n>= 01-01-1953 \t<= 31-08-1955 \t= 66 \t= 4 \t= Waar \n>= 01-09-1955 \t<= 31-05-1956 \t= 66 \t= 7 \t= Waar \n>= 01-06-1956 \t<= 28-02-1957 \t= 66 \t= 10 \t= Waar \n>= 01-03-1957 \t<= 31-12-1960 \t= 67 \t= 0 \t= Waar \n>= 01-01-1961 \t<= 30-09-1962 \t= 67 \t= 3 \t= Waar \n>= 01-10-1962 \t<= 30-09-1963 \t= 67 \t= 3 \t= Waar \n>= 01-10-1963 \t<= 30-09-1964 \t= 67 \t= 3 \t= Waar \n>= 01-10-1964 \t- \t= 67 \t= 3 \t= Onwaar \n"@nl  .

<https://regels.overheid.nl/register/uwv/39c60bb7-4905-48d0-8774-7b5718ca5a36> a cpsv:Rule, cprmv:TemporalRule ;
    cpsv:implements <https://regels.overheid.nl/services/aow-leeftijd-uwv> ;
