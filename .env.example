# Backend API URL
# Development: http://localhost:3001
# Acceptance:  https://acc.backend.linkeddata.open-regels.nl
# Production:  https://backend.linkeddata.open-regels.nl
VITE_BACKEND_URL=

# Operaton DMN engine URL
# Development: http://localhost:8081
# Acceptance:  https://operaton.open-regels.nl
# Production:  https://operaton.open-regels.nl
VITE_OPERATON_URL=

# Environment indicator (development, acceptance, production)
VITE_ENV=
