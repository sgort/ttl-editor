{
  "name": "ttl-editor",
  "version": "2026.08.3",
  "private": true,
  "dependencies": {
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^13.5.0",
    "lucide-react": "^0.545.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-scripts": "5.0.1",
    "web-vitals": "^2.1.4"
  },
  "scripts": {
    "start": "react-scripts start",
    "build": "react-scripts build",
    "test": "react-scripts test",
    "test:ci": "react-scripts test --watchAll=false --coverage",
    "test:generator": "react-scripts test --watchAll=false --testPathPattern=ttlGenerator",
    "test:generator:watch": "react-scripts test --testPathPattern=ttlGenerator",
    "test:roundtrip": "react-scripts test --watchAll=false --testPathPattern=roundtrip",
    "test:roundtrip:watch": "react-scripts test --testPathPattern=roundtrip",
    "test:p2": "react-scripts test --watchAll=false --testPathPattern=\"validators|ttlHelpers|ronlHelper|dmnHelpers|iknowParser|cprmvImport\"",
    "test:p2:watch": "react-scripts test --testPathPattern=\"validators|ttlHelpers|ronlHelper|dmnHelpers|iknowParser|cprmvImport\"",
    "test:p3": "react-scripts test --watchAll=false --testPathPattern=\"useEditorState|useArrayHandlers|useDsoImport\"",
    "test:p3:watch": "react-scripts test --testPathPattern=\"useEditorState|useArrayHandlers|useDsoImport\"",
    "test:p4": "react-scripts test --watchAll=false --testPathPattern=\"shaclHelper|triplydbHelper\"",
    "test:p4:watch": "react-scripts test --testPathPattern=\"shaclHelper|triplydbHelper\"",
    "eject": "react-scripts eject",
    "prepare": "husky",
    "lint": "eslint \"src/**/*.{js,jsx,ts,tsx}\"",
    "lint:fix": "eslint \"src/**/*.{js,jsx,ts,tsx}\" --fix",
    "format": "prettier --write .",
    "check-format": "prettier --check ."
  },
  "eslintConfig": {
    "extends": [
      "react-app",
      "react-app/jest"
    ]
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "devDependencies": {
    "autoprefixer": "^10.4.21",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-prettier": "^5.5.4",
    "eslint-plugin-simple-import-sort": "^12.1.1",
    "husky": "^9.1.7",
    "lint-staged": "^16.2.7",
    "postcss": "^8.5.6",
    "prettier": "^3.7.4",
    "tailwindcss": "^4.0.0",
    "typescript": "^4.9.5"
  },
  "lint-staged": {
    "src/**/*.{js,jsx,ts,tsx,json,css,md}": [
      "prettier --write",
      "eslint --fix"
    ],
    "package.json": [
      "prettier --write"
    ]
  }
}
