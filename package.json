{
  "name": "ttl-editor",
  "version": "2026.09.0",
  "private": true,
  "dependencies": {
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^7.0.0",
    "@testing-library/react": "^16.3.0",
    "lucide-react": "^1.0.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "scripts": {
    "start": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test": "vitest",
    "test:ci": "vitest run --coverage",
    "test:generator": "vitest run ttlGenerator",
    "test:generator:watch": "vitest ttlGenerator",
    "test:roundtrip": "vitest run roundtrip",
    "test:roundtrip:watch": "vitest roundtrip",
    "test:p2": "vitest run validators ttlHelpers ronlHelper dmnHelpers iknowParser cprmvImport",
    "test:p2:watch": "vitest validators ttlHelpers ronlHelper dmnHelpers iknowParser cprmvImport",
    "test:p3": "vitest run useEditorState useArrayHandlers useDsoImport",
    "test:p3:watch": "vitest useEditorState useArrayHandlers useDsoImport",
    "test:p4": "vitest run shaclHelper triplydbHelper",
    "test:p4:watch": "vitest shaclHelper triplydbHelper",
    "test:p5": "vitest run PreviewPanel PublishDialog ServiceTab CostSection OutputSection OrganizationTab LegalTab RulesTab ParametersTab ConceptsTab CPRMVTab ChangelogTab IKnowImportTab IKnowMappingTab VendorTab",
    "test:p5:watch": "vitest PreviewPanel PublishDialog ServiceTab CostSection OutputSection OrganizationTab LegalTab RulesTab ParametersTab ConceptsTab CPRMVTab ChangelogTab IKnowImportTab IKnowMappingTab VendorTab",
    "test:p6": "vitest run DMNTab",
    "test:p6:watch": "vitest DMNTab",
    "prepare": "husky",
    "lint": "eslint \"src/**/*.{js,jsx,ts,tsx}\"",
    "lint:fix": "eslint \"src/**/*.{js,jsx,ts,tsx}\" --fix",
    "format": "prettier --write .",
    "check-format": "prettier --check .",
    "check-supply-chain": "node scripts/check-supply-chain.mjs"
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^5.2.0",
    "@vitest/coverage-v8": "^4.1.11",
    "autoprefixer": "^10.4.21",
    "eslint": "^8.57.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-config-react-app": "^7.0.1",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-prettier": "^5.5.4",
    "eslint-plugin-simple-import-sort": "^14.0.0",
    "husky": "^9.1.7",
    "jsdom": "^30.0.0",
    "lint-staged": "^17.0.0",
    "postcss": "^8.5.6",
    "prettier": "^3.7.4",
    "tailwindcss": "^3.4.18",
    "typescript": "^4.9.5",
    "vite": "^8.2.2",
    "vitest": "^4.1.11"
  },
  "lint-staged": {
    "src/**/*.{js,jsx,ts,tsx,json,css,md}": [
      "prettier --write",
      "eslint --fix"
    ],
    "package.json": [
      "prettier --write"
    ]
  }
}
